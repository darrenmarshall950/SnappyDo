# ---------- Public (browser-visible) ----------
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ---------- Server-only secrets ----------
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=change-me-to-a-long-random-string

# ---------- imgproxy (Horizon by default; override for local) ----------
IMGPROXY_URL=http://horizon.local:8080
IMGPROXY_KEY=
IMGPROXY_SALT=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Cloudflare R2 (S3-compatible) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=snappydo-uploads

# ---------- Runtime ----------
NODE_ENV=production
PORT=3000

# ---------- Local Postgres (self-host profile only) ----------
POSTGRES_USER=snappydo
POSTGRES_PASSWORD=snappydo
POSTGRES_DB=snappydo
POSTGRES_PORT=5432
