---
// /upload — drag-drop upload UI, sends to /api/upload
import { listGalleries } from '../lib/db';
const galleries = listGalleries();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Upload — SnappyDo</title>
    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: #050505;
        color: #fafafa;
        min-height: 100vh;
      }
      .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 2rem;
        border-bottom: 1px solid #1a1a1a;
      }
      .page-header__brand {
        font-weight: 800;
        font-size: 1.125rem;
        color: #fafafa;
        text-decoration: none;
        letter-spacing: -0.02em;
      }
      .page-header__back {
        color: #888;
        text-decoration: none;
        font-size: 0.875rem;
        padding: 0.4375rem 0.875rem;
        border-radius: 999px;
        transition: color 0.2s, background 0.2s;
      }
      .page-header__back:hover { color: #fafafa; background: rgba(255,255,255,0.06); }
      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 3rem 2rem 6rem;
      }
      h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 800;
        margin: 0 0 0.5rem;
        letter-spacing: -0.03em;
      }
      .sub {
        color: #888;
        margin: 0 0 2.5rem;
        font-size: 1rem;
      }
      label {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #888;
        font-weight: 500;
        margin-bottom: 0.5rem;
      }
      select {
        width: 100%;
        padding: 0.75rem 1rem;
        background: #0a0a0a;
        border: 1px solid #2a2a2a;
        border-radius: 6px;
        color: #fafafa;
        font-size: 1rem;
        font-family: inherit;
        margin-bottom: 2rem;
      }
      select:focus { outline: 2px solid #fafafa; outline-offset: 1px; }
      .dropzone {
        border: 2px dashed #2a2a2a;
        border-radius: 12px;
        padding: 4rem 2rem;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease;
        background: rgba(255,255,255,0.01);
      }
      .dropzone:hover, .dropzone.is-dragging {
        border-color: #fafafa;
        background: rgba(255,255,255,0.04);
      }
      .dropzone__icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.6;
      }
      .dropzone__text {
        font-size: 1.125rem;
        margin: 0 0 0.5rem;
      }
      .dropzone__hint {
        font-size: 0.875rem;
        color: #888;
        margin: 0;
      }
      .progress {
        margin-top: 2rem;
        display: none;
      }
      .progress.is-active { display: block; }
      .progress__bar {
        height: 4px;
        background: #1a1a1a;
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 1rem;
      }
      .progress__fill {
        height: 100%;
        background: linear-gradient(90deg, #fafafa, #888);
        width: 0%;
        transition: width 0.3s ease;
      }
      .progress__list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8125rem;
        color: #888;
        max-height: 200px;
        overflow-y: auto;
      }
      .progress__list li {
        padding: 0.5rem 0;
        border-bottom: 1px solid #1a1a1a;
      }
      .progress__list li.is-success { color: #4ade80; }
      .progress__list li.is-error { color: #f87171; }
      .progress__list li.is-pending { color: #888; }
      .progress__list li.is-rendering { color: #facc15; }

      /* Per-file progress bar (inside the LI) */
      .file-progress {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8125rem;
      }
      .file-progress__name {
        flex: 0 1 auto;
        max-width: 50%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .file-progress__bar {
        flex: 1 1 auto;
        height: 4px;
        background: #1a1a1a;
        border-radius: 999px;
        overflow: hidden;
        min-width: 60px;
      }
      .file-progress__fill {
        height: 100%;
        background: linear-gradient(90deg, #fafafa, #888);
        width: 0%;
        transition: width 0.15s linear;
      }
      /* Indeterminate animation when RAW is being processed by darktable-cli */
      .file-progress__fill.is-indeterminate {
        width: 30% !important;
        background: linear-gradient(90deg, transparent, #facc15, transparent);
        animation: file-indeterminate 1.4s ease-in-out infinite;
      }
      @keyframes file-indeterminate {
        0%   { transform: translateX(-100%); }
        100% { transform: translateX(330%); }
      }
      .file-progress__pct {
        flex: 0 0 3.5rem;
        text-align: right;
        font-variant-numeric: tabular-nums;
        color: inherit;
      }
    </style>
  </head>
  <body>
    <header class="page-header">
      <a href="/" class="page-header__brand">SnappyDo</a>
      <a href="/" class="page-header__back">← Home</a>
    </header>

    <main>
      <h1>Upload photos</h1>
      <p class="sub">Drag photos into the box. EXIF is extracted automatically. Images are transformed on-demand by imgproxy.</p>

      <label for="gallery">Destination gallery</label>
      <select id="gallery">
        {galleries.map((g) => (
          <option value={g.slug}>{g.title} ({g.slug})</option>
        ))}
      </select>

      <label>Files</label>
      <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Click or drop files to upload">
        <div class="dropzone__icon">⤴</div>
        <p class="dropzone__text">Drop photos here, or click to browse</p>
        <p class="dropzone__hint">JPEG, PNG, WebP, AVIF, HEIC, plus RAW (RW2, ORF, DNG, CR2, NEF, ARW, RAF...) · up to 100 MB each</p>
        <input id="file-input" type="file" accept="image/*,.rw2,.orf,.dng,.cr2,.cr3,.nef,.nrw,.arw,.srf,.sr2,.raf,.pef,.3fr,.iiq,.x3f,.mrw,.rwl" multiple hidden />
      </div>

      <div id="progress" class="progress">
        <div class="progress__bar"><div id="progress-fill" class="progress__fill"></div></div>
        <ul id="progress-list" class="progress__list"></ul>
      </div>
    </main>

    <script>
      const dropzone = document.getElementById('dropzone');
            const fileInput = document.getElementById('file-input');
            const gallerySelect = document.getElementById('gallery');
            const progress = document.getElementById('progress');
            const progressFill = document.getElementById('progress-fill');
            const progressList = document.getElementById('progress-list');

            /**
             * v0.8 upload resilience — chunked + parallel + resumable
             *
             *   - Batch files into chunks of BATCH_SIZE (default 8). One chunk per
             *     XHR request, so a server hiccup only loses a chunk, not all 100.
             *   - Send up to BATCH_CONCURRENCY chunks in parallel. Tracks aggregate
             *     progress across all in-flight chunks.
             *   - Persist uploaded file names+bytes+lastModified to localStorage so a
             *     page reload (or the user clicking "Retry") skips already-uploaded
             *     files automatically — true resume.
             *   - Retry each chunk up to 3 times with exponential backoff.
             */

            const BATCH_SIZE = 8;
            const BATCH_CONCURRENCY = 3;
            // RAW preview rendering runs through darktable-cli, so keep it
            // isolated from the lightweight JPEG queue and serialised.
            const RAW_BATCH_SIZE = 1;
            const RAW_BATCH_CONCURRENCY = 1;
            const MAX_RETRIES = 3;
            const STORAGE_PREFIX = 'snappydo-uploads:';

            // ───────────────────────────────────────────────────────────────
            // Hash a file's identity (name + size + mtime). Two identical-looking
            // uploads from different sessions still dedupe correctly because we
            // include size and lastModified.
            // ───────────────────────────────────────────────────────────────
            function fileKey(f) {
              return `${f.name}|${f.size}|${f.lastModified}`;
            }

            function loadSession(gallerySlug) {
              try {
                const raw = localStorage.getItem(STORAGE_PREFIX + gallerySlug);
                return raw ? new Set(JSON.parse(raw)) : new Set();
              } catch {
                return new Set();
              }
            }

            function saveSession(gallerySlug, set) {
              try {
                localStorage.setItem(STORAGE_PREFIX + gallerySlug, JSON.stringify([...set]));
              } catch {
                // localStorage full or unavailable — not fatal
              }
            }

            function clearSession(gallerySlug) {
              try { localStorage.removeItem(STORAGE_PREFIX + gallerySlug); } catch {}
            }

            // ───────────────────────────────────────────────────────────────
            // UI helpers
            // ───────────────────────────────────────────────────────────────
            // log() — final-state log entry (success/error). Per-file progress
            // entries are created by addFileProgress() and updated via the
            // returned handle. This is used for top-level status messages.
            function log(name, ok, msg = '') {
              const li = document.createElement('li');
              li.className = ok ? 'is-success' : 'is-error';
              li.textContent = (ok ? '✓ ' : '✗ ') + name + (msg ? ' — ' + msg : '');
              progressList.appendChild(li);
            }

            // createFileProgress(name) — append a new per-file progress row and
            // return { setPercent(pct), setRendering(), setDone(msg), setError(msg) }
            // to mutate the same row in place.
            function createFileProgress(name) {
              const li = document.createElement('li');
              li.className = 'is-pending';
              const wrap = document.createElement('div');
              wrap.className = 'file-progress';
              const nameSpan = document.createElement('span');
              nameSpan.className = 'file-progress__name';
              nameSpan.textContent = name;
              const bar = document.createElement('div');
              bar.className = 'file-progress__bar';
              const fill = document.createElement('div');
              fill.className = 'file-progress__fill';
              bar.appendChild(fill);
              const pct = document.createElement('span');
              pct.className = 'file-progress__pct';
              pct.textContent = '0%';
              wrap.appendChild(nameSpan);
              wrap.appendChild(bar);
              wrap.appendChild(pct);
              li.appendChild(wrap);
              progressList.appendChild(li);
              return {
                setPercent(v) {
                  fill.classList.remove('is-indeterminate');
                  fill.style.width = Math.max(0, Math.min(100, v)) + '%';
                  pct.textContent = Math.round(v) + '%';
                },
                setRendering() {
                  li.classList.remove('is-pending', 'is-success', 'is-error');
                  li.classList.add('is-rendering');
                  fill.classList.add('is-indeterminate');
                  pct.textContent = '…';
                },
                setDone(msg) {
                  li.classList.remove('is-pending', 'is-rendering', 'is-error');
                  li.classList.add('is-success');
                  fill.classList.remove('is-indeterminate');
                  fill.style.width = '100%';
                  pct.textContent = msg || '✓';
                },
                setError(msg) {
                  li.classList.remove('is-pending', 'is-rendering', 'is-success');
                  li.classList.add('is-error');
                  fill.classList.remove('is-indeterminate');
                  pct.textContent = '✗';
                },
              };
            }

            // isRawFile(f) — mirror of the server-side RAW_EXTENSIONS set.
            // The server treats these specially (calls darktable-cli) so the UI
            // shows an indeterminate "rendering" state while waiting.
            function isRawFile(f) {
              const name = (f.name || '').toLowerCase();
              const m = name.match(/\.([a-z0-9]+)$/);
              if (!m) return false;
              const ext = m[1];
              return ['rw2','orf','dng','cr2','cr3','nef','nrw','arw','srf','sr2',
                      'raf','pef','3fr','iiq','x3f','mrw','rwl'].includes(ext);
            }

            function chunk(arr, n) {
              const out = [];
              for (let i = 0; i < arr.length; i += n) out.push(arr.slice(i, i + n));
              return out;
            }

            function sleep(ms) {
              return new Promise((r) => setTimeout(r, ms));
            }

            // ───────────────────────────────────────────────────────────────
            // One POST request for a single batch. Returns the parsed response.
            // Throws on network error or non-2xx.
            // ───────────────────────────────────────────────────────────────
            function sendChunk(slug, batch, onChunkProgress) {
              return new Promise((resolve, reject) => {
                const formData = new FormData();
                formData.append('gallery_slug', slug);
                batch.forEach((f) => formData.append('files', f));

                const xhr = new XMLHttpRequest();
                xhr.open('POST', '/api/upload');

                // XHR progress event only gives aggregate loaded/total for the
                // whole request. With one file that's accurate. With multi-file
                // batches we approximate per-file by loaded / total ratio and
                // scale each file's expected size.
                let totalRequestBytes = 0;
                for (const f of batch) totalRequestBytes += f.size;

                xhr.upload.addEventListener('progress', (e) => {
                  if (!e.lengthComputable || totalRequestBytes === 0) return;
                  // Distribute progress across files in order. Each file shows
                  // its share of the request so far (loaded * file.size / total).
                  const fileStates = {};
                  let cumulative = 0;
                  for (let i = 0; i < batch.length; i++) {
                    const f = batch[i];
                    const start = cumulative;
                    const end = cumulative + f.size;
                    let fileLoaded;
                    if (e.loaded >= end) {
                      fileLoaded = f.size;       // fully uploaded
                    } else if (e.loaded > start) {
                      fileLoaded = e.loaded - start;
                    } else {
                      fileLoaded = 0;            // not started yet
                    }
                    cumulative = end;
                    fileStates[i] = { loaded: fileLoaded, total: f.size };
                  }
                  onChunkProgress({ phase: 'upload', fileStates });
                });

                xhr.upload.addEventListener('loadend', () => {
                  // HTTP upload complete. Switch per-file state to 'rendering'
                  // so the UI shows the indeterminate animation while
                  // darktable-cli processes RAW files. (For non-RAW, this is
                  // brief enough that the indeterminate flash is fine.)
                  const fileStates = {};
                  for (let i = 0; i < batch.length; i++) {
                    fileStates[i] = { loaded: batch[i].size, total: batch[i].size };
                  }
                  onChunkProgress({ phase: 'rendering', fileStates });
                });

                xhr.addEventListener('load', () => {
                  let body = {};
                  try { body = JSON.parse(xhr.responseText); } catch {}
                  if (xhr.status >= 200 && xhr.status < 300) {
                    resolve(body);
                  } else {
                    reject(new Error(body?.error || `HTTP ${xhr.status}`));
                  }
                });
                xhr.addEventListener('error', () => reject(new Error('network error')));
                xhr.addEventListener('abort', () => reject(new Error('aborted')));
                xhr.send(formData);
              });
            }

            // Retry loop with exponential backoff
            async function sendChunkWithRetry(slug, batch, onChunkProgress) {
              let lastErr;
              for (let attempt = 0; attempt < MAX_RETRIES; attempt++) {
                try {
                  return await sendChunk(slug, batch, onChunkProgress);
                } catch (err) {
                  lastErr = err;
                  const delay = 500 * Math.pow(2, attempt);
                  log(`batch of ${batch.length} (attempt ${attempt + 1}/${MAX_RETRIES})`, false, `${err.message} — retrying in ${delay}ms`);
                  await sleep(delay);
                }
              }
              throw lastErr;
            }

            // Concurrency-limited parallel runner
            async function runParallel(tasks, concurrency, eachTask) {
              const queue = [...tasks];
              const inFlight = [];
              async function worker() {
                while (queue.length) {
                  const task = queue.shift();
                  await eachTask(task);
                }
              }
              for (let i = 0; i < concurrency && i < queue.length + inFlight.length; i++) {
                inFlight.push(worker());
              }
              await Promise.all(inFlight);
            }

            // ───────────────────────────────────────────────────────────────
            // Main upload — chunked, parallel, resumable
            // ───────────────────────────────────────────────────────────────
            async function upload(files) {
              const slug = gallerySelect.value;
              if (!slug) {
                log('no gallery selected', false);
                return;
              }

              // Filter out non-images. The browser reports RAW camera files
              // (Panasonic .rw2, Olympus .orf, etc.) with type === '' or
              // 'application/octet-stream' because the OS doesn't assign a
              // real MIME. We accept anything that looks like an image MIME
              // OR has a known RAW extension so they don't get silently
              // dropped before they reach the server.
              const allFiles = files.filter((f) =>
                f.type.startsWith('image/') || isRawFile(f)
              );
              if (!allFiles.length) {
                log('no images to upload', false);
                return;
              }

              // Skip already-uploaded files using localStorage session
              const session = loadSession(slug);
              const toUpload = allFiles.filter((f) => !session.has(fileKey(f)));
              const skipped = allFiles.length - toUpload.length;

              progress.classList.add('is-active');
              progressList.innerHTML = '';

              if (skipped > 0) {
                log(`skipped ${skipped} already-uploaded file(s) (resuming)`, true, 'refresh-free');
              }

              if (!toUpload.length) {
                progressFill.style.width = '100%';
                return;
              }

              // Per-file UI: create one progress row per file before we start.
              // Order is preserved (chunking keeps order within batches).
              const fileRows = toUpload.map((f) => createFileProgress(f.name));

              // Track per-file uploaded bytes so the aggregate bar reflects
              // reality even when chunks run in parallel.
              const fileLoaded = new Array(toUpload.length).fill(0);
              const fileDone = new Array(toUpload.length).fill(false);
              let totalBytes = 0;
              for (const f of toUpload) totalBytes += f.size;

              const updateAggregateFill = () => {
                let loaded = 0;
                for (let i = 0; i < toUpload.length; i++) {
                  loaded += fileLoaded[i] || 0;
                }
                const pct = totalBytes > 0 ? Math.round((loaded / totalBytes) * 100) : 0;
                progressFill.style.width = Math.min(100, pct) + '%';
              };

              const normalFiles = toUpload
                .map((file, originalIndex) => ({ file, originalIndex }))
                .filter(({ file }) => !isRawFile(file));
              const rawFiles = toUpload
                .map((file, originalIndex) => ({ file, originalIndex }))
                .filter(({ file }) => isRawFile(file));
              const normalChunks = chunk(normalFiles, BATCH_SIZE);
              const rawChunks = chunk(rawFiles, RAW_BATCH_SIZE);
              const chunks = [...normalChunks, ...rawChunks];
              log(`uploading ${toUpload.length} file(s) in ${chunks.length} batch(es): ${BATCH_CONCURRENCY} normal batch(es) and ${RAW_BATCH_CONCURRENCY} RAW batch in parallel`, true);

              // Process ordinary images quickly, but never let RAW previews fan
              // out into many simultaneous darktable-cli processes.
              const makeTasks = (batches, startIndex) => batches.map((batch, offset) => async () => {
                const idx = startIndex + offset;
                const batchNames = batch.map((b) => b.file.name).join(', ');
                try {
                  const res = await sendChunkWithRetry(slug, batch.map((b) => b.file), ({ phase, fileStates }) => {
                    // fileStates keys are 0..batch.length-1 (local index)
                    for (let li = 0; li < batch.length; li++) {
                      const state = fileStates[li];
                      const globalIdx = batch[li].originalIndex;
                      if (phase === 'upload' && state) {
                        fileLoaded[globalIdx] = state.loaded;
                        const pct = state.total > 0 ? (state.loaded / state.total) * 100 : 0;
                        fileRows[globalIdx].setPercent(pct);
                      } else if (phase === 'rendering') {
                        fileLoaded[globalIdx] = state.total;
                        fileRows[globalIdx].setRendering();
                      }
                    }
                    updateAggregateFill();
                  });
                  // Success — mark each file as done and record in session
                  for (const b of batch) {
                    const i = b.originalIndex;
                    fileLoaded[i] = b.file.size;
                    fileDone[i] = true;
                    session.add(fileKey(b.file));
                  }
                  updateAggregateFill();
                  for (const u of (res.uploaded || [])) {
                    const idx = toUpload.findIndex((f) => f.name === u.original_name);
                    if (idx >= 0) {
                      fileRows[idx].setDone(`${u.width}×${u.height}`);
                    } else {
                      log(u.original_name, true, `${u.width}×${u.height} · ${(u.bytes/1024).toFixed(0)} KB`);
                    }
                  }
                  for (const m of (res.errors || [])) log(m, false);
                } catch (err) {
                  for (const b of batch) {
                    fileRows[b.originalIndex].setError();
                  }
                  log(`batch #${idx + 1} (${batchNames})`, false, err.message);
                }
              });

              const normalTasks = makeTasks(normalChunks, 0);
              const rawTasks = makeTasks(rawChunks, normalChunks.length);
              await Promise.all([
                runParallel(normalTasks, BATCH_CONCURRENCY, async (t) => t()),
                runParallel(rawTasks, RAW_BATCH_CONCURRENCY, async (t) => t()),
              ]);

              // Persist session for resume
              saveSession(slug, session);

              const remaining = allFiles.length - skipped - (session.size - skipped);
              if (remaining > 0) {
                log(`${remaining} file(s) failed — click Retry or re-drop them to retry`, false);
              } else {
                log(`all ${toUpload.length} file(s) uploaded ✓`, true);
                // Optionally clear session now that everything succeeded
                // (kept around for resume-on-reload; clear if user starts fresh)
              }
            }

            // ───────────────────────────────────────────────────────────────
            // Event wiring
            // ───────────────────────────────────────────────────────────────
            dropzone.addEventListener('click', () => fileInput.click());
            dropzone.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                fileInput.click();
              }
            });

            ['dragenter', 'dragover'].forEach((ev) =>
              dropzone.addEventListener(ev, (e) => {
                e.preventDefault();
                dropzone.classList.add('is-dragging');
              }),
            );
            ['dragleave', 'drop'].forEach((ev) =>
              dropzone.addEventListener(ev, (e) => {
                e.preventDefault();
                dropzone.classList.remove('is-dragging');
              }),
            );
            dropzone.addEventListener('drop', (e) => {
              const files = Array.from(e.dataTransfer.files);
              if (files.length) upload(files);
            });
            fileInput.addEventListener('change', () => {
              const files = Array.from(fileInput.files || []);
              if (files.length) upload(files);
              fileInput.value = '';
            });

            // Retry button (if present in markup) — re-attempts any failed files.
            // Failed files are those in the most recent attempt that didn't make
            // it into the session. Simplest impl: re-running upload() on the same
            // file set skips already-uploaded ones via localStorage.
            const retryBtn = document.getElementById('retry-btn');
            if (retryBtn) {
              retryBtn.addEventListener('click', () => {
                // We don't have the original File objects after a page reload.
                // If the page is reloaded, the user must re-drop the files — and
                // upload() will skip the ones already in the session.
                alert('Re-drop the files you want to retry. Already-uploaded ones will be skipped automatically.');
                fileInput.click();
              });
            }
    </script>
  </body>
</html>
