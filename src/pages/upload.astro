---
// /upload — drag-drop upload UI, sends to /api/upload
import { listGalleries } from '../lib/db';
const galleries = listGalleries();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Upload — SnappyDo</title>
    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: #050505;
        color: #fafafa;
        min-height: 100vh;
      }
      .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 2rem;
        border-bottom: 1px solid #1a1a1a;
      }
      .page-header__brand {
        font-weight: 800;
        font-size: 1.125rem;
        color: #fafafa;
        text-decoration: none;
        letter-spacing: -0.02em;
      }
      .page-header__back {
        color: #888;
        text-decoration: none;
        font-size: 0.875rem;
        padding: 0.4375rem 0.875rem;
        border-radius: 999px;
        transition: color 0.2s, background 0.2s;
      }
      .page-header__back:hover { color: #fafafa; background: rgba(255,255,255,0.06); }
      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 3rem 2rem 6rem;
      }
      h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 800;
        margin: 0 0 0.5rem;
        letter-spacing: -0.03em;
      }
      .sub {
        color: #888;
        margin: 0 0 2.5rem;
        font-size: 1rem;
      }
      label {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #888;
        font-weight: 500;
        margin-bottom: 0.5rem;
      }
      select {
        width: 100%;
        padding: 0.75rem 1rem;
        background: #0a0a0a;
        border: 1px solid #2a2a2a;
        border-radius: 6px;
        color: #fafafa;
        font-size: 1rem;
        font-family: inherit;
        margin-bottom: 2rem;
      }
      select:focus { outline: 2px solid #fafafa; outline-offset: 1px; }
      .dropzone {
        border: 2px dashed #2a2a2a;
        border-radius: 12px;
        padding: 4rem 2rem;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease;
        background: rgba(255,255,255,0.01);
      }
      .dropzone:hover, .dropzone.is-dragging {
        border-color: #fafafa;
        background: rgba(255,255,255,0.04);
      }
      .dropzone__icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.6;
      }
      .dropzone__text {
        font-size: 1.125rem;
        margin: 0 0 0.5rem;
      }
      .dropzone__hint {
        font-size: 0.875rem;
        color: #888;
        margin: 0;
      }
      .progress {
        margin-top: 2rem;
        display: none;
      }
      .progress.is-active { display: block; }
      .progress__bar {
        height: 4px;
        background: #1a1a1a;
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 1rem;
      }
      .progress__fill {
        height: 100%;
        background: linear-gradient(90deg, #fafafa, #888);
        width: 0%;
        transition: width 0.3s ease;
      }
      .progress__list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8125rem;
        color: #888;
        max-height: 200px;
        overflow-y: auto;
      }
      .progress__list li {
        padding: 0.375rem 0;
        border-bottom: 1px solid #1a1a1a;
      }
      .progress__list li.is-success { color: #4ade80; }
      .progress__list li.is-error { color: #f87171; }
    </style>
  </head>
  <body>
    <header class="page-header">
      <a href="/" class="page-header__brand">SnappyDo</a>
      <a href="/" class="page-header__back">← Home</a>
    </header>

    <main>
      <h1>Upload photos</h1>
      <p class="sub">Drag photos into the box. EXIF is extracted automatically. Images are transformed on-demand by imgproxy.</p>

      <label for="gallery">Destination gallery</label>
      <select id="gallery">
        {galleries.map((g) => (
          <option value={g.slug}>{g.title} ({g.slug})</option>
        ))}
      </select>

      <label>Files</label>
      <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Click or drop files to upload">
        <div class="dropzone__icon">⤴</div>
        <p class="dropzone__text">Drop photos here, or click to browse</p>
        <p class="dropzone__hint">JPEG, PNG, WebP, AVIF, HEIC · up to 50 MB each</p>
        <input id="file-input" type="file" accept="image/*" multiple hidden />
      </div>

      <div id="progress" class="progress">
        <div class="progress__bar"><div id="progress-fill" class="progress__fill"></div></div>
        <ul id="progress-list" class="progress__list"></ul>
      </div>
    </main>

    <script>
      const dropzone = document.getElementById('dropzone');
      const fileInput = document.getElementById('file-input');
      const gallerySelect = document.getElementById('gallery');
      const progress = document.getElementById('progress');
      const progressFill = document.getElementById('progress-fill');
      const progressList = document.getElementById('progress-list');

      let currentXhr = null;

      dropzone.addEventListener('click', () => fileInput.click());
      dropzone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          fileInput.click();
        }
      });

      ['dragenter', 'dragover'].forEach((ev) =>
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.add('is-dragging');
        }),
      );
      ['dragleave', 'drop'].forEach((ev) =>
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.remove('is-dragging');
        }),
      );
      dropzone.addEventListener('drop', (e) => {
        const files = Array.from(e.dataTransfer.files).filter((f) => f.type.startsWith('image/'));
        if (files.length) upload(files);
      });
      fileInput.addEventListener('change', () => {
        const files = Array.from(fileInput.files || []);
        if (files.length) upload(files);
        fileInput.value = '';
      });

      function log(name, ok, msg = '') {
        const li = document.createElement('li');
        li.className = ok ? 'is-success' : 'is-error';
        li.textContent = (ok ? '✓ ' : '✗ ') + name + (msg ? ' — ' + msg : '');
        progressList.appendChild(li);
      }

      function upload(files) {
        const formData = new FormData();
        formData.append('gallery_slug', gallerySelect.value);
        files.forEach((f) => formData.append('files', f));

        progress.classList.add('is-active');
        progressList.innerHTML = '';
        progressFill.style.width = '0%';

        const xhr = new XMLHttpRequest();
        currentXhr = xhr;
        xhr.open('POST', '/api/upload');

        xhr.upload.addEventListener('progress', (e) => {
          if (e.lengthComputable) {
            progressFill.style.width = Math.round((e.loaded / e.total) * 100) + '%';
          }
        });

        xhr.addEventListener('load', () => {
          let body = {};
          try { body = JSON.parse(xhr.responseText); } catch {}
          if (xhr.status >= 200 && xhr.status < 300) {
            (body.uploaded || []).forEach((u) => log(u.original_name, true, `${u.width}×${u.height} · ${(u.bytes/1024).toFixed(0)} KB`));
            (body.errors || []).forEach((m) => log(m, false));
            progressFill.style.width = '100%';
          } else {
            log('upload failed: HTTP ' + xhr.status, false, body.error || '');
          }
        });

        xhr.addEventListener('error', () => log('network error', false));
        xhr.send(formData);
      }
    </script>
  </body>
</html>
