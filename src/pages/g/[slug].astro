---
// Dynamic gallery page — picks template from query param ?t=grid|masonry|lightbox
import { getGalleryBySlug, galleries } from '../../data/galleries';
import { templateDefaults, type GalleryTemplateId } from '../../lib/gallery-schemas';
import GridGallery from '../../components/gallery/GridGallery.astro';
import MasonryGallery from '../../components/gallery/MasonryGallery.astro';
import LightboxGallery from '../../components/gallery/LightboxGallery.astro';
import TemplatePicker from '../../components/gallery/TemplatePicker.astro';

export const prerender = false;

const { slug } = Astro.params;
const gallery = slug ? getGalleryBySlug(slug) : undefined;

if (!gallery) {
  return Astro.redirect('/');
}

const templateParam = Astro.url.searchParams.get('t');
const validTemplates: GalleryTemplateId[] = ['grid', 'masonry', 'lightbox'];
const template: GalleryTemplateId = validTemplates.includes(templateParam as GalleryTemplateId)
  ? (templateParam as GalleryTemplateId)
  : 'masonry';

const config = templateDefaults[template];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{gallery.title} — SnappyDo</title>
    <meta name="description" content={gallery.description} />
  </head>
  <body>
    <header class="page-header">
      <a href="/" class="page-header__brand">SnappyDo</a>
      <nav class="page-header__nav">
        {galleries.map((g) => (
          <a href={`/g/${g.slug}`} class:list={['page-header__link', { 'is-current': g.slug === gallery.slug }]}>
            {g.title}
          </a>
        ))}
      </nav>
    </header>

    <main class="gallery-page">
      <section class="gallery-page__head">
        <h1>{gallery.title}</h1>
        <p>{gallery.description}</p>
        <TemplatePicker current={template} gallerySlug={gallery.slug} />
      </section>

      {template === 'grid' && <GridGallery images={gallery.images} config={config} gallerySlug={gallery.slug} />}
      {template === 'masonry' && <MasonryGallery images={gallery.images} config={config} gallerySlug={gallery.slug} />}
      {template === 'lightbox' && <LightboxGallery images={gallery.images} config={config} gallerySlug={gallery.slug} />}
    </main>

    <footer class="page-footer">
      <span>SnappyDo v0.2 — gallery template prototype</span>
      <span>Template: <code>{template}</code></span>
    </footer>

    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: #050505;
        color: #fafafa;
        min-height: 100vh;
      }
      .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 2rem;
        border-bottom: 1px solid #1a1a1a;
        position: sticky;
        top: 0;
        background: rgba(5, 5, 5, 0.85);
        backdrop-filter: blur(12px);
        z-index: 50;
      }
      .page-header__brand {
        font-weight: 800;
        font-size: 1.125rem;
        color: #fafafa;
        text-decoration: none;
        letter-spacing: -0.02em;
      }
      .page-header__nav {
        display: flex;
        gap: 0.25rem;
      }
      .page-header__link {
        padding: 0.4375rem 0.875rem;
        border-radius: 999px;
        color: #888;
        text-decoration: none;
        font-size: 0.875rem;
        transition: color 0.2s ease, background 0.2s ease;
      }
      .page-header__link:hover { color: #fafafa; background: rgba(255, 255, 255, 0.06); }
      .page-header__link.is-current { color: #fafafa; background: rgba(255, 255, 255, 0.1); }
      .gallery-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 3rem 2rem 5rem;
      }
      .gallery-page__head {
        margin-bottom: 2.5rem;
        display: grid;
        gap: 1rem;
      }
      .gallery-page__head h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.03em;
        line-height: 1.1;
      }
      .gallery-page__head p {
        margin: 0;
        color: #888;
        font-size: 1.0625rem;
        max-width: 640px;
      }
      .page-footer {
        display: flex;
        justify-content: space-between;
        padding: 2rem;
        border-top: 1px solid #1a1a1a;
        color: #555;
        font-size: 0.8125rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .page-footer code {
        background: rgba(255, 255, 255, 0.06);
        padding: 0.125rem 0.5rem;
        border-radius: 4px;
        color: #fafafa;
      }
    </style>
  </body>
</html>
