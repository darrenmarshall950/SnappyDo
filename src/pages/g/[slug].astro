---
// Dynamic gallery page — reads from DB, falls back to sample data if empty.
import {
  getGalleryBySlug,
  listImagesForGallery,
  type GalleryRow,
  type ImageRow,
} from '../../lib/db';
import { adaptImage, type AdaptedImage } from '../../lib/image-adapter';
import { templateDefaults, VALID_TEMPLATES, type GalleryTemplateId, type FrameStyle } from '../../lib/gallery-schemas';
import GridGallery from '../../components/gallery/GridGallery.astro';
import MasonryGallery from '../../components/gallery/MasonryGallery.astro';
import LightboxGallery from '../../components/gallery/LightboxGallery.astro';
import CoverGallery from '../../components/gallery/CoverGallery.astro';
import CarouselGallery from '../../components/gallery/CarouselGallery.astro';
import SlideshowGallery from '../../components/gallery/SlideshowGallery.astro';
import JustifiedGallery from '../../components/gallery/JustifiedGallery.astro';
import PolaroidGallery from '../../components/gallery/PolaroidGallery.astro';
import MosaicGallery from '../../components/gallery/MosaicGallery.astro';
import CinemaGallery from '../../components/gallery/CinemaGallery.astro';
import FramedGallery from '../../components/gallery/FramedGallery.astro';
import TemplatePicker from '../../components/gallery/TemplatePicker.astro';
import FramePicker from '../../components/gallery/FramePicker.astro';
import { galleries as sampleGalleries } from '../../data/galleries';
import { getGalleryBySlug as findSampleGallery } from '../../data/galleries';

export const prerender = false;

const { slug } = Astro.params;

const dbGallery = slug ? getGalleryBySlug(slug) : undefined;

if (!dbGallery) {
  return Astro.redirect('/');
}

// Pick template — query param > gallery default > 'masonry'
const templateParam = Astro.url.searchParams.get('t');
let template: GalleryTemplateId = VALID_TEMPLATES.includes(templateParam as GalleryTemplateId)
  ? (templateParam as GalleryTemplateId)
  : (dbGallery.template_id as GalleryTemplateId);
if (!VALID_TEMPLATES.includes(template)) template = 'masonry';

const config = templateDefaults[template];

// Frame style — query param wins, then config default, then 'matte'
const VALID_FRAMES: FrameStyle[] = ['none', 'matte', 'gallery', 'polaroid'];
const frameParam = Astro.url.searchParams.get('frame');
const frameStyle: FrameStyle = (VALID_FRAMES.includes(frameParam as FrameStyle)
  ? (frameParam as FrameStyle)
  : (config.frame ?? 'matte')) as FrameStyle;
// Override config.frame with the chosen style for this render
if (template === 'framed') {
  config.frame = frameStyle;
}

// Read images from DB
const dbImages = listImagesForGallery(dbGallery.id);
let images: AdaptedImage[] = dbImages.map((row) => adaptImage(row, config));

// Fallback to sample data if DB has no images for this gallery yet
if (images.length === 0) {
  const sample = findSampleGallery(dbGallery.slug);
  if (sample) {
    images = sample.images.map((img, i) => ({
      id: -1 - i,
      src: img.src,
      thumb: img.thumb,
      srcset: `${img.thumb} 600w, ${img.src} 2000w`,
      width: img.width,
      height: img.height,
      alt: img.alt,
      exif: img.exif,
    }));
  }
}

const allDbGalleries = (await import('../../lib/db')).listGalleries();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{dbGallery.title} — SnappyDo</title>
    <meta name="description" content={dbGallery.description} />
  </head>
  <body>
    <header class="page-header">
      <a href="/" class="page-header__brand">SnappyDo</a>
      <nav class="page-header__nav">
        {allDbGalleries.map((g: GalleryRow) => (
          <a href={`/g/${g.slug}`} class:list={['page-header__link', { 'is-current': g.slug === dbGallery.slug }]}>
            {g.title}
          </a>
        ))}
        <a href="/upload" class="page-header__upload">↑ Upload</a>
      </nav>
    </header>

    <main class="gallery-page">
      <section class="gallery-page__head">
        <div>
          <h1>{dbGallery.title}</h1>
          <p>{dbGallery.description}</p>
          <p class="gallery-page__meta">
            <span><strong>{images.length}</strong> photos</span>
            <span class="dot">·</span>
            <span>Powered by imgproxy</span>
          </p>
        </div>
        <div class="gallery-page__head-actions">
          <TemplatePicker current={template} gallerySlug={dbGallery.slug} />
          <FramePicker current={frameStyle} gallerySlug={dbGallery.slug} template={template} />
        </div>
      </section>

      {images.length === 0 && (
        <div class="gallery-page__empty">
          <p>No photos in this gallery yet.</p>
          <a href={`/upload`} class="empty-upload-btn">Upload the first photo →</a>
        </div>
      )}

      {template === 'grid' && images.length > 0 && <GridGallery images={images} config={config} gallerySlug={dbGallery.slug} />}
      {template === 'masonry' && images.length > 0 && <MasonryGallery images={images} config={config} gallerySlug={dbGallery.slug} />}
      {template === 'lightbox' && images.length > 0 && <LightboxGallery images={images} config={config} gallerySlug={dbGallery.slug} />}
      {template === 'cover' && images.length > 0 && <CoverGallery images={images} config={config} galleryTitle={dbGallery.title} />}
      {template === 'carousel' && images.length > 0 && <CarouselGallery images={images} config={config} galleryTitle={dbGallery.title} />}
      {template === 'slideshow' && images.length > 0 && <SlideshowGallery images={images} config={config} galleryTitle={dbGallery.title} />}
      {template === 'justified' && images.length > 0 && <JustifiedGallery images={images} config={config} galleryTitle={dbGallery.title} />}
      {template === 'polaroid' && images.length > 0 && <PolaroidGallery images={images} config={config} galleryTitle={dbGallery.title} />}
      {template === 'mosaic' && images.length > 0 && <MosaicGallery images={images} config={config} galleryTitle={dbGallery.title} />}
      {template === 'cinema' && images.length > 0 && <CinemaGallery images={images} config={config} galleryTitle={dbGallery.title} />}
      {template === 'framed' && images.length > 0 && <FramedGallery images={images} config={config} galleryTitle={dbGallery.title} />}
    </main>

    <footer class="page-footer">
      <span>SnappyDo v0.4 — 11 templates + photo zoom + watermarks</span>
      <span>Template: <code>{template}</code></span>
    </footer>

    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: #050505;
        color: #fafafa;
        min-height: 100vh;
      }
      .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 2rem;
        border-bottom: 1px solid #1a1a1a;
        position: sticky;
        top: 0;
        background: rgba(5, 5, 5, 0.85);
        backdrop-filter: blur(12px);
        z-index: 50;
      }
      .page-header__brand {
        font-weight: 800;
        font-size: 1.125rem;
        color: #fafafa;
        text-decoration: none;
        letter-spacing: -0.02em;
      }
      .page-header__nav {
        display: flex;
        gap: 0.25rem;
        align-items: center;
      }
      .page-header__link {
        padding: 0.4375rem 0.875rem;
        border-radius: 999px;
        color: #888;
        text-decoration: none;
        font-size: 0.875rem;
        transition: color 0.2s ease, background 0.2s ease;
      }
      .page-header__link:hover { color: #fafafa; background: rgba(255, 255, 255, 0.06); }
      .page-header__link.is-current { color: #fafafa; background: rgba(255, 255, 255, 0.1); }
      .page-header__upload {
        padding: 0.4375rem 0.875rem;
        border-radius: 999px;
        background: #fafafa;
        color: #0a0a0a;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        margin-left: 0.5rem;
      }
      .gallery-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 3rem 2rem 5rem;
      }
      .gallery-page__head {
        margin-bottom: 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 2rem;
        flex-wrap: wrap;
      }
      .gallery-page__head h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 800;
        margin: 0 0 0.5rem;
        letter-spacing: -0.03em;
        line-height: 1.1;
      }
      .gallery-page__head p {
        margin: 0 0 0.75rem;
        color: #888;
        font-size: 1.0625rem;
        max-width: 640px;
      }
      .gallery-page__meta {
        font-size: 0.8125rem;
        color: #555;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .gallery-page__head-actions {
        display: inline-flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-items: center;
      }
      .gallery-page__meta strong { color: #fafafa; font-weight: 600; }
      .gallery-page__meta .dot { margin: 0 0.5rem; }
      .gallery-page__empty {
        text-align: center;
        padding: 5rem 2rem;
        border: 1px dashed #2a2a2a;
        border-radius: 12px;
        color: #888;
      }
      .empty-upload-btn {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.75rem 1.5rem;
        background: #fafafa;
        color: #0a0a0a;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 500;
      }
      .page-footer {
        display: flex;
        justify-content: space-between;
        padding: 2rem;
        border-top: 1px solid #1a1a1a;
        color: #555;
        font-size: 0.8125rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .page-footer code {
        background: rgba(255, 255, 255, 0.06);
        padding: 0.125rem 0.5rem;
        border-radius: 4px;
        color: #fafafa;
      }
    </style>
  </body>
</html>
