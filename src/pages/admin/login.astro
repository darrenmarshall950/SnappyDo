---
/**
 * Admin login page. POSTs to /admin/api/login which sets the session cookie.
 * On success, redirects to ?next= or /admin.
 */
export const prerender = false;

const next = Astro.url.searchParams.get('next') || '/admin';
const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — SnappyDo Admin</title>
  </head>
  <body class="login-body">
    <main class="login-card">
      <header class="login-card__head">
        <p class="login-card__brand">SnappyDo</p>
        <h1 class="login-card__title">Sign in</h1>
        <p class="login-card__sub">Photographer dashboard</p>
      </header>

      {error && (
        <p class="login-card__error" role="alert">
          {error === 'invalid' ? 'Wrong username or password.' : 'Sign-in failed. Try again.'}
        </p>
      )}

      <form class="login-form" method="POST" action="/admin/api/login" autocomplete="on">
        <input type="hidden" name="next" value={next} />
        <label class="login-form__field">
          <span>Username</span>
          <input type="text" name="username" autocomplete="username" required autofocus />
        </label>
        <label class="login-form__field">
          <span>Password</span>
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button type="submit" class="login-form__submit">Sign in →</button>
      </form>

      <footer class="login-card__foot">
        <a href="/">← Back to site</a>
      </footer>
    </main>
    <style>
      :root { color-scheme: dark; }
      .login-body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: #050505;
        color: #fafafa;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
      }
      .login-card {
        width: 100%;
        max-width: 420px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        padding: 2.5rem;
        backdrop-filter: blur(12px);
      }
      .login-card__head { margin-bottom: 2rem; text-align: center; }
      .login-card__brand {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.6875rem;
        letter-spacing: 0.24em;
        color: #888;
        text-transform: uppercase;
        margin: 0 0 0.75rem;
      }
      .login-card__title {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        margin: 0 0 0.25rem;
      }
      .login-card__sub {
        font-size: 0.875rem;
        color: #888;
        margin: 0;
      }
      .login-card__error {
        background: rgba(220, 38, 38, 0.12);
        border: 1px solid rgba(220, 38, 38, 0.32);
        color: #fca5a5;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        margin: 0 0 1.25rem;
      }
      .login-form { display: flex; flex-direction: column; gap: 1rem; }
      .login-form__field { display: flex; flex-direction: column; gap: 0.5rem; }
      .login-form__field span {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.6875rem;
        color: #888;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .login-form__field input {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid #2a2a2a;
        color: #fafafa;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 1rem;
        font-family: inherit;
        transition: border-color 0.15s ease;
      }
      .login-form__field input:focus {
        outline: none;
        border-color: #fafafa;
      }
      .login-form__submit {
        background: #fafafa;
        color: #0a0a0a;
        border: 0;
        padding: 0.875rem 1rem;
        border-radius: 8px;
        font-size: 0.9375rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 0.5rem;
        transition: transform 0.15s ease;
      }
      .login-form__submit:hover { transform: translateY(-1px); }
      .login-form__submit:active { transform: translateY(0); }
      .login-card__foot {
        margin-top: 1.5rem;
        text-align: center;
        font-size: 0.8125rem;
      }
      .login-card__foot a {
        color: #888;
        text-decoration: none;
      }
      .login-card__foot a:hover { color: #fafafa; }
    </style>
  </body>
</html>
