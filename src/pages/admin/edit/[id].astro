---
/**
 * Image editor — single-image Lightroom-feel colour grading + crop.
 *
 * Pipeline:
 *   1. Load image at full resolution from imgproxy (or original)
 *   2. Paint to <canvas> via WebGL fragment shader (all adjustments)
 *   3. User adjusts sliders → uniform updates → instant preview
 *   4. Crop rectangle drawn as overlay; if set, fragment shader remaps UV
 *   5. On Save: render at NATIVE resolution via canvas.toBlob('image/jpeg', 0.95)
 *      → POST to /api/images/:id/edit
 *      → server stores at /uploads/edits/{id}/edit-{ts}.jpg + image_edits row
 *   6. Originals are NEVER touched
 *
 * Auth: middleware-protected (admin only).
 */
import { getImage } from '../../../lib/db';
import { adaptImage } from '../../../lib/image-adapter';
import { getLatestImageEdit, listImageEdits } from '../../../lib/db-image-edits';
import { imgproxyUrl } from '../../../lib/imgproxy';

export const prerender = false;

const id = Number(Astro.params.id);
const img = Number.isFinite(id) ? getImage(id) : undefined;
if (!img) return Astro.redirect('/admin', 302);

const latestEdit = getLatestImageEdit(id);
const initialParams = latestEdit ? JSON.parse(latestEdit.params_json) : {
  exposure: 0, contrast: 0, saturation: 0, brightness: 0,
  highlights: 0, shadows: 0, whites: 0, blacks: 0,
  temp: 0, tint: 0, sharpen: 0, vignette: 0,
  crop: null, // { x, y, w, h } in 0..1 UV space, or null
};

// Source URL — use the original file directly so we get full resolution.
// imgproxy's "no resize" passthrough would be ideal but can be slow on large files.
// The full-resolution URL via imgproxy: format=jpg, quality=95, no width cap.
const sourceUrl = `/api/images/${img.id}/source`;
      // Same-origin endpoint with CORS headers; keeps the WebGL canvas un-tainted
      // so canvas.toBlob() works on Save. imgproxy's URLs are cross-origin
      // (host:8090 vs the editor on host:3010) and don't ship CORS, which
      // silently fails <img crossorigin="anonymous">.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit — {img.original_name}</title>
    <style>
      :root {
        --bg: #0a0a0a;
        --panel: #141414;
        --panel-2: #1a1a1a;
        --border: #262626;
        --text: #fafafa;
        --muted: #888;
        --accent: #fafafa;
        --accent-bg: #fafafa;
        --accent-fg: #0a0a0a;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 14px;
        overflow: hidden;
      }
      .editor {
        display: grid;
        grid-template-columns: 1fr 360px;
        grid-template-rows: 56px 1fr;
        grid-template-areas:
          "top top"
          "canvas panel";
        height: 100vh;
      }
      .top {
        grid-area: top;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1rem;
        background: var(--panel);
        border-bottom: 1px solid var(--border);
        gap: 1rem;
      }
      .top-title {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.875rem;
        min-width: 0;
      }
      .top-title h1 {
        font-size: 0.9375rem;
        font-weight: 600;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 50vw;
      }
      .top-title .meta {
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
      }
      .top-actions {
        display: flex;
        gap: 0.5rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.9rem;
        border-radius: 6px;
        font-size: 0.8125rem;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        border: 1px solid var(--border);
        background: var(--panel-2);
        color: var(--text);
        font-family: inherit;
        transition: all 0.15s ease;
      }
      .btn:hover { border-color: #555; }
      .btn--primary {
        background: var(--accent-bg);
        color: var(--accent-fg);
        border-color: var(--accent-bg);
      }
      .btn--primary:hover { transform: translateY(-1px); }
      .btn--danger {
        color: #fca5a5;
        border-color: rgba(220, 38, 38, 0.32);
      }
      .btn--danger:hover { background: rgba(220, 38, 38, 0.12); }
      .btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
      }
      .canvas-area {
        grid-area: canvas;
        background: #050505;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        min-width: 0;
      }
      .canvas-wrap {
        position: relative;
        max-width: 100%;
        max-height: 100%;
        line-height: 0;
      }
      canvas#preview {
        max-width: 100%;
        max-height: calc(100vh - 56px);
        object-fit: contain;
        cursor: crosshair;
        display: block;
      }
      .canvas-hint {
        position: absolute;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        color: var(--muted);
        font-size: 0.75rem;
        background: rgba(0, 0, 0, 0.6);
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        pointer-events: none;
      }
      .panel {
        grid-area: panel;
        background: var(--panel);
        border-left: 1px solid var(--border);
        overflow-y: auto;
        display: flex;
        flex-direction: column;
      }
      .panel-section {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border);
      }
      .panel-section h3 {
        margin: 0 0 0.875rem;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .panel-section h3 button {
        font-size: 0.6875rem;
        color: var(--muted);
        background: transparent;
        border: none;
        cursor: pointer;
        text-transform: none;
        letter-spacing: 0;
        padding: 0;
        font-weight: 400;
      }
      .panel-section h3 button:hover { color: var(--text); }
      .slider {
        display: grid;
        grid-template-columns: 1fr 56px;
        align-items: center;
        gap: 0.5rem 0.75rem;
        margin-bottom: 0.5rem;
      }
      .slider label {
        font-size: 0.8125rem;
        color: #d4d4d4;
      }
      .slider input[type="range"] {
        grid-column: 1 / 2;
        width: 100%;
        accent-color: #fafafa;
      }
      .slider .val {
        grid-column: 2 / 3;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
        color: var(--muted);
        text-align: right;
      }
      .crop-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .crop-buttons .btn {
        flex: 1 1 auto;
        justify-content: center;
        padding: 0.4rem 0.6rem;
        font-size: 0.75rem;
      }
      .crop-buttons .btn.active {
        background: var(--accent-bg);
        color: var(--accent-fg);
        border-color: var(--accent-bg);
      }
      .status {
        padding: 0.5rem 1.25rem;
        font-size: 0.75rem;
        background: var(--panel-2);
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .status.error { color: #fca5a5; }
      .status.ok { color: #86efac; }
      .toast {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.85);
        color: var(--text);
        padding: 0.75rem 1.25rem;
        border-radius: 999px;
        font-size: 0.8125rem;
        z-index: 100;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s ease;
      }
      .toast.visible { opacity: 1; }
      a.back-link {
        color: var(--muted);
        text-decoration: none;
        margin-right: 0.5rem;
        font-size: 0.8125rem;
      }
      a.back-link:hover { color: var(--text); }

      /* ============================================================
         MOBILE (≤768px) — stack vertically; let the page scroll;
         give the canvas real room instead of squeezing it.
         ============================================================ */
      @media (max-width: 768px) {
        html, body {
          overflow: auto;          /* allow scroll on mobile */
          height: auto;            /* drop the 100vh trap */
        }
        .editor {
          grid-template-columns: 1fr;
          grid-template-rows: auto auto 1fr;
          grid-template-areas:
            "top"
            "panel"
            "canvas";
          height: auto;            /* page grows to fit content */
        }
        .top {
          flex-wrap: wrap;
          padding: 0.5rem 0.75rem;
          gap: 0.5rem;
        }
        .top-title h1 {
          max-width: 60vw;
          font-size: 0.8125rem;
        }
        .top-title .meta {
          display: none;           /* 2066×3672 etc. takes too much room */
        }
        .top-actions {
          width: 100%;
          justify-content: flex-end;
        }
        .top-actions .btn {
          padding: 0.4rem 0.6rem;
          font-size: 0.75rem;
        }
        /* Reorder: top → canvas → panel. Above rule stacks them
           top/panel/canvas. Use order to put canvas first after top. */
        .top { order: 1; }
        .canvas-area { order: 2; }
        .panel { order: 3; }
        .canvas-area {
          min-height: 60vh;        /* canvas gets real estate */
          border-bottom: 1px solid var(--border);
        }
        canvas#preview {
          max-height: 60vh;        /* override the calc(100vh-56px) for mobile */
          max-width: 100%;
          width: auto;
          height: auto;
        }
        .panel {
          border-left: none;
          border-top: 1px solid var(--border);
          max-height: none;
        }
        .panel-section {
          padding: 0.75rem 1rem;
        }
      }

      @media (max-width: 420px) {
        .top-actions .btn-label { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="editor">
      <header class="top">
        <div class="top-title">
          <a class="back-link" href={`/admin/galleries/${img.gallery_id}`}>← Back</a>
          <h1>{img.original_name}</h1>
          <span class="meta">{img.width}×{img.height} · {img.mime}</span>
        </div>
        <div class="top-actions">
          <button class="btn" id="btn-reset">Reset</button>
          <button class="btn btn--danger" id="btn-revert" disabled={!latestEdit}>Revert to original</button>
          <button class="btn btn--primary" id="btn-save">Save edit</button>
        </div>
      </header>

      <div class="canvas-area">
        <div class="canvas-wrap">
          <canvas id="preview"></canvas>
          <div id="crop-overlay"></div>
          <div class="canvas-hint">Drag on the image to set a crop · Sliders adjust live · Save to bake it in</div>
        </div>
      </div>

      <aside class="panel">
        <section class="panel-section">
          <h3>Light</h3>
          <div class="slider" data-key="exposure">
            <label>Exposure</label>
            <input type="range" min="-200" max="200" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="contrast">
            <label>Contrast</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="brightness">
            <label>Brightness</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <section class="panel-section">
          <h3>Tone <button id="btn-reset-tone">reset</button></h3>
          <div class="slider" data-key="highlights">
            <label>Highlights</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="shadows">
            <label>Shadows</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="whites">
            <label>Whites</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="blacks">
            <label>Blacks</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <section class="panel-section">
          <h3>Color <button id="btn-reset-color">reset</button></h3>
          <div class="slider" data-key="saturation">
            <label>Saturation</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="temp">
            <label>Temperature</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="tint">
            <label>Tint</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <section class="panel-section">
          <h3>Effects <button id="btn-reset-fx">reset</button></h3>
          <div class="slider" data-key="sharpen">
            <label>Sharpen</label>
            <input type="range" min="0" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="vignette">
            <label>Vignette</label>
            <input type="range" min="0" max="100" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <section class="panel-section">
          <h3>Crop</h3>
          <div class="crop-buttons">
            <button class="btn" data-aspect="free">Free</button>
            <button class="btn" data-aspect="1:1">1:1</button>
            <button class="btn" data-aspect="4:3">4:3</button>
            <button class="btn" data-aspect="3:2">3:2</button>
            <button class="btn" data-aspect="16:9">16:9</button>
            <button class="btn" id="btn-clear-crop">Clear</button>
          </div>
        </section>

        <div class="status" id="status">Ready.</div>
      </aside>
    </div>

    <div class="toast" id="toast"></div>

    <script type="module" define:vars={{
      imageId: img.id,
      sourceUrl,
      initialParams,
      hasExistingEdit: !!latestEdit,
    }}>
      // ---- MINIMAL DIAGNOSTIC — replace complex WebGL with a basic 2D canvas
      // render. If this works (image visible), the issue was in the WebGL
      // shader compilation or texture upload. If this still shows black, the
      // problem is elsewhere (image src, layout, canvas dimensions).
      (function () {
        const status = document.getElementById('status');
        const canvas = document.getElementById('preview');
        const ctx = canvas.getContext('2d');
        if (!ctx) {
          status.textContent = 'Canvas 2D NOT available';
          status.classList.add('error');
          return;
        }
        status.textContent = 'JS boot OK. Loading…';

        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = () => {
          status.textContent = 'Image loaded ' + img.width + 'x' + img.height + '.';
          const area = document.querySelector('.canvas-area');
          const aw = area ? area.clientWidth : window.innerWidth;
          const ah = area ? area.clientHeight : window.innerHeight;
          const scale = Math.min(aw / img.width, ah / img.height, 1);
          const dw = Math.max(1, Math.round(img.width * scale));
          const dh = Math.max(1, Math.round(img.height * scale));
          canvas.width = dw;
          canvas.height = dh;
          canvas.style.width = dw + 'px';
          canvas.style.height = dh + 'px';
          ctx.fillStyle = '#888';
          ctx.fillRect(0, 0, dw, dh);
          ctx.drawImage(img, 0, 0, dw, dh);
          status.textContent = 'Rendered at ' + dw + 'x' + dh + '.';
        };
        img.onerror = (e) => {
          status.textContent = 'Image load FAILED';
          status.classList.add('error');
        };
        img.src = sourceUrl;
      })();
</script>
  </body>
</html>
