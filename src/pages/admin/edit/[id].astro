---
/**
 * Image editor — single-image Lightroom-feel colour grading + crop.
 *
 * Pipeline:
 *   1. Load image at full resolution from imgproxy (or original)
 *   2. Paint to <canvas> via WebGL fragment shader (all adjustments)
 *   3. User adjusts sliders → uniform updates → instant preview
 *   4. Crop rectangle drawn as overlay; if set, fragment shader remaps UV
 *   5. On Save: render at NATIVE resolution via canvas.toBlob('image/jpeg', 0.95)
 *      → POST to /api/images/:id/edit
 *      → server stores at /uploads/edits/{id}/edit-{ts}.jpg + image_edits row
 *   6. Originals are NEVER touched
 *
 * Auth: middleware-protected (admin only).
 */
import { getImage } from '../../../lib/db';
import { adaptImage } from '../../../lib/image-adapter';
import { getLatestImageEdit, listImageEdits } from '../../../lib/db-image-edits';
import { imgproxyUrl } from '../../../lib/imgproxy';

import { buildLut, isFlat } from '../../../lib/curve';
import type { CurveData } from '../../../lib/curve';
function parseExif(json: string | null | undefined): Record<string, any> {
  if (!json) return {};
  try { return JSON.parse(json); } catch { return {}; }
}
function formatExif(exif: Record<string, any>) {
  return {
    camera:      exif.camera      || '',
    lens:        exif.lens        || '',
    iso:         exif.iso         || '',
    aperture:    exif.aperture    || '',
    shutter:     exif.shutter     || '',
    focalLength: exif.focalLength || '',
    takenAt:     exif.takenAt     || '',
  };
}
export const prerender = false;

const id = Number(Astro.params.id);
const img = Number.isFinite(id) ? getImage(id) : undefined;
if (!img) return Astro.redirect('/admin', 302);

const exif = formatExif(parseExif(img.exif_json));
const isRaw = !!img.raw_path;

// Default values for RAW-only controls. Kelvin is 5500 (daylight),
// not 0, because "no WB adjustment" is a real setting, not "off".
const RAW_DEFAULTS: Record<string, number | boolean> = {
  raw_wb_kelvin: 5500,
  raw_wb_tint: 0,
  raw_nr_lum: 0,
  raw_nr_chroma: 0,
  raw_lens_on: 0,
};
const RAW_KEYS = Object.keys(RAW_DEFAULTS);

const latestEdit = getLatestImageEdit(id);
const initialParams = latestEdit ? JSON.parse(latestEdit.params_json) : {
  exposure: 0, contrast: 0, saturation: 0, brightness: 0,
  highlights: 0, shadows: 0, whites: 0, blacks: 0,
  temp: 0, tint: 0, sharpen: 0, vignette: 0,
  ...RAW_DEFAULTS,
  crop: null, // { x, y, w, h } in 0..1 UV space, or null
  // Color Grading
  hsl_red: { h: 0, s: 0, l: 0 }, hsl_orange: { h: 0, s: 0, l: 0 },
  hsl_yellow: { h: 0, s: 0, l: 0 }, hsl_green: { h: 0, s: 0, l: 0 },
  hsl_aqua: { h: 0, s: 0, l: 0 }, hsl_blue: { h: 0, s: 0, l: 0 },
  hsl_purple: { h: 0, s: 0, l: 0 }, hsl_magenta: { h: 0, s: 0, l: 0 },
  cg_shadows_colour: [0, 0, 0], cg_midtones_colour: [0, 0, 0],
  cg_highlights_colour: [0, 0, 0], cg_global_colour: [0, 0, 0],
  cg_shadows_intensity: 0, cg_midtones_intensity: 0,
  cg_highlights_intensity: 0, cg_global_intensity: 0,
  cg_mode: 'saturation',
  // Split Toning
  st_shadows_hue: 0, st_shadows_saturation: 0,
  st_highlights_hue: 0, st_highlights_saturation: 0,
  st_balance: 0,
  // Grain
  grain_amount: 0, grain_size: 25,
  // Effects
  dehaze: 0,
};

// Source URL — use the original file directly so we get full resolution.
// imgproxy's "no resize" passthrough would be ideal but can be slow on large files.
// The full-resolution URL via imgproxy: format=jpg, quality=95, no width cap.
const sourceUrl = `/api/images/${img.id}/source`;
// Feature flag: when SNAPPYDO_RAW_PREVIEW_RENDER=1, the editor requests
// darktable-cli renders of the RAW with current XMP params on slider-release
// (cached by hash). Default OFF — set the env to enable.
const rawPreviewEnabled = process.env.SNAPPYDO_RAW_PREVIEW_RENDER === '1';
      // Same-origin endpoint with CORS headers; keeps the WebGL canvas un-tainted
      // so canvas.toBlob() works on Save. imgproxy's URLs are cross-origin
      // (host:8090 vs the editor on host:3010) and don't ship CORS, which
      // silently fails <img crossorigin="anonymous">.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit — {img.original_name}</title>
    <style>
      :root {
        --bg: #0a0a0a;
        --panel: #141414;
        --panel-2: #1a1a1a;
        --border: #262626;
        --text: #fafafa;
        --muted: #888;
        --accent: #fafafa;
        --accent-bg: #fafafa;
        --accent-fg: #0a0a0a;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 14px;
        overflow: hidden;
      }
      .editor {
        display: grid;
        grid-template-columns: 1fr 360px;
        grid-template-rows: 56px 1fr;
        grid-template-areas:
          "top top"
          "canvas panel";
        height: 100vh;
      }
      .top {
        grid-area: top;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1rem;
        background: var(--panel);
        border-bottom: 1px solid var(--border);
        gap: 1rem;
      }
      .top-title {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.875rem;
        min-width: 0;
      }
      .top-title h1 {
        font-size: 0.9375rem;
        font-weight: 600;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 50vw;
      }
      .top-title .meta {
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
      }
      .top-actions {
        display: flex;
        gap: 0.5rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.9rem;
        border-radius: 6px;
        font-size: 0.8125rem;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        border: 1px solid var(--border);
        background: var(--panel-2);
        color: var(--text);
        font-family: inherit;
        transition: all 0.15s ease;
      }
      .btn:hover { border-color: #555; }
      .btn--primary {
        background: var(--accent-bg);
        color: var(--accent-fg);
        border-color: var(--accent-bg);
      }
      .btn--primary:hover { transform: translateY(-1px); }
      .btn--danger {
        color: #fca5a5;
        border-color: rgba(220, 38, 38, 0.32);
      }
      .btn--danger:hover { background: rgba(220, 38, 38, 0.12); }
      .btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
      }
      .canvas-area {
        grid-area: canvas;
        background: #050505;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        min-width: 0;
      }
      .canvas-wrap {
        position: relative;
        max-width: 100%;
        max-height: 100%;
        line-height: 0;
      }
      /* When zoomed, canvas-wrap becomes a viewport that may scroll
         (or we pan the canvas via JS). Position canvas absolutely so
         pan offsets translate correctly. */
      .canvas-wrap.zoomed {
        overflow: hidden;
        width: 100%;
        height: 100%;
        position: relative;
      }
      .canvas-wrap.zoomed canvas#preview {
        position: absolute;
        cursor: grab;
        max-width: none;
        max-height: none;
        object-fit: none;
      }
      .canvas-wrap.zoomed canvas#preview:active {
        cursor: grabbing;
      }
      canvas#preview {
        max-width: 100%;
        max-height: calc(100vh - 56px);
        object-fit: contain;
        cursor: crosshair;
        display: block;
      }
      .zoom-controls {
        position: absolute;
        bottom: 1rem;
        right: 1rem;
        display: flex;
        gap: 0.25rem;
        background: rgba(10, 10, 10, 0.78);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.25rem;
        backdrop-filter: blur(6px);
        z-index: 5;
      }
      .zoom-controls button {
        background: transparent;
        border: 1px solid transparent;
        color: var(--text);
        padding: 0.35rem 0.7rem;
        font-size: 0.75rem;
        font-family: inherit;
        cursor: pointer;
        border-radius: 5px;
        font-weight: 500;
        letter-spacing: 0.02em;
      }
      .zoom-controls button:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.08);
      }
      .zoom-controls button.active {
        background: var(--accent-bg);
        color: var(--accent-fg);
      }
      .zoom-controls .zoom-hint {
        padding: 0.35rem 0.6rem;
        font-size: 0.6875rem;
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        align-self: center;
        margin-left: 0.25rem;
        border-left: 1px solid var(--border);
        padding-left: 0.6rem;
      }
      .vignette-overlay {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(ellipse at center,
          rgba(0,0,0,0) 30%,
          rgba(0,0,0,0.85) 100%);
        transition: opacity 0.1s ease;
      }
      .canvas-hint {
        position: absolute;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        color: var(--muted);
        font-size: 0.75rem;
        background: rgba(0, 0, 0, 0.6);
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        pointer-events: none;
      }
      .panel {
        grid-area: panel;
        background: var(--panel);
        border-left: 1px solid var(--border);
        overflow-y: auto;
        display: flex;
        flex-direction: column;
      }
      .panel-section {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border);
      }
      .panel-section h3 {
        margin: 0 0 0.875rem;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .panel-section h3 button {
        font-size: 0.6875rem;
        color: var(--muted);
        background: transparent;
        border: none;
        cursor: pointer;
        text-transform: none;
        letter-spacing: 0;
        padding: 0;
        font-weight: 400;
      }
      .panel-section h3 button:hover { color: var(--text); }
      .raw-note {
        font-size: 0.6875rem;
        color: var(--muted);
        margin: 0 0 0.75rem;
        font-style: italic;
        line-height: 1.35;
      }
      .lens-badge {
        display: inline-block;
        margin-left: 8px;
        padding: 1px 6px;
        background: #1c5d99;
        color: #fff;
        font-size: 10px;
        font-weight: bold;
        border-radius: 3px;
        letter-spacing: 0.5px;
      }
      .raw-subhead {
        font-size: 0.6875rem;
        color: var(--text);
        margin: 0.625rem 0 0.375rem;
        font-weight: 600;
        letter-spacing: 0.04em;
      }
      .checkbox-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        color: #d4d4d4;
        margin: 0.25rem 0;
      }
      .checkbox-row input[type="checkbox"] {
        width: 14px;
        height: 14px;
        accent-color: #fafafa;
        cursor: pointer;
      }
      .slider {
        display: grid;
        grid-template-columns: 1fr 56px;
        align-items: center;
        gap: 0.5rem 0.75rem;
        margin-bottom: 0.5rem;
      }
      .slider label {
        font-size: 0.8125rem;
        color: #d4d4d4;
      }
      .slider input[type="range"] {
        grid-column: 1 / 2;
        width: 100%;
        accent-color: #fafafa;
      }
      .slider .val {
        grid-column: 2 / 3;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
        color: var(--muted);
        text-align: right;
      }
      .crop-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .crop-buttons .btn {
        flex: 1 1 auto;
        justify-content: center;
        padding: 0.4rem 0.6rem;
        font-size: 0.75rem;
      }
      .crop-buttons .btn.active {
        background: var(--accent-bg);
        color: var(--accent-fg);
        border-color: var(--accent-bg);
      }
      .btn--ghost {
        background: transparent;
        color: var(--accent-fg);
        border-color: var(--border);
      }
      .btn--ghost:hover { background: var(--bg-hover); border-color: var(--accent); }
      .btn--ghost.active {
        background: var(--accent-bg);
        color: var(--accent-fg);
        border-color: var(--accent-bg);
      }
      .btn-compare-pill {
        padding: 0.5rem 1rem;
        font-weight: 600;
        background: var(--bg);
        border-color: var(--accent);
        color: var(--accent-fg);
      }
      .btn-compare-pill.active { background: var(--accent-bg); color: white; }
      .compare-icon {
        display: block;
        flex-shrink: 0;
      }
      .kbd-key {
        display: inline-block;
        padding: 0.1rem 0.5rem;
        margin-right: 0.4rem;
        background: var(--accent-bg);
        color: white;
        border-radius: 4px;
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
      }
      .compare-indicator {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(0, 0, 0, 0.7);
        color: #fafafa;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.875rem;
        letter-spacing: 0.1em;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.12s ease;
        z-index: 1000;
      }
      .compare-indicator.visible { opacity: 1; }
      .status {
        padding: 0.5rem 1.25rem;
        font-size: 0.75rem;
        background: var(--panel-2);
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .status.error { color: #fca5a5; }
      .status.ok { color: #86efac; }

      /* EXIF strip — directly below the status bar. Empty fields hidden. */
      .exif {
        padding: 0.45rem 1.25rem 0.6rem;
        font-size: 0.6875rem;
        background: var(--panel-2);
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        display: flex;
        flex-wrap: wrap;
        gap: 0.15rem 0.85rem;
        line-height: 1.4;
      }
      .exif .exif__item { white-space: nowrap; }
      .exif .exif__k { color: #888; margin-right: 0.25rem; }
      .exif .exif__v { color: #fafafa; }
      .exif .exif__camera { flex-basis: 100%; }
      .toast {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.85);
        color: var(--text);
        padding: 0.75rem 1.25rem;
        border-radius: 999px;
        font-size: 0.8125rem;
        z-index: 100;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s ease;
      }
      .toast.visible { opacity: 1; }
      a.back-link {
        color: var(--muted);
        text-decoration: none;
        margin-right: 0.5rem;
        font-size: 0.8125rem;
      }
      a.back-link:hover { color: var(--text); }

      /* ============================================================
         MOBILE (≤768px) — stack vertically; let the page scroll;
         give the canvas real room instead of squeezing it.
         ============================================================ */
      @media (max-width: 768px) {
        html, body {
          overflow: auto;          /* allow scroll on mobile */
          height: auto;            /* drop the 100vh trap */
        }
        .editor {
          grid-template-columns: 1fr;
          grid-template-rows: auto auto 1fr;
          grid-template-areas:
            "top"
            "panel"
            "canvas";
          height: auto;            /* page grows to fit content */
        }
        .top {
          flex-wrap: wrap;
          padding: 0.5rem 0.75rem;
          gap: 0.5rem;
        }
        .top-title h1 {
          max-width: 60vw;
          font-size: 0.8125rem;
        }
        .top-title .meta {
          display: none;           /* 2066×3672 etc. takes too much room */
        }
        .top-actions {
          width: 100%;
          justify-content: flex-end;
        }
        .top-actions .btn {
          padding: 0.4rem 0.6rem;
          font-size: 0.75rem;
        }
        /* Reorder: top → canvas → panel. Above rule stacks them
           top/panel/canvas. Use order to put canvas first after top. */
        .top { order: 1; }
        .canvas-area { order: 2; }
        .panel { order: 3; }
        .canvas-area {
          min-height: 60vh;        /* canvas gets real estate */
          border-bottom: 1px solid var(--border);
        }
        canvas#preview {
          max-height: 60vh;        /* override the calc(100vh-56px) for mobile */
          max-width: 100%;
          width: auto;
          height: auto;
        }
        .panel {
          border-left: none;
          border-top: 1px solid var(--border);
          max-height: none;
        }
        .panel-section {
          padding: 0.75rem 1rem;
        }
      }

      @media (max-width: 420px) {
        .top-actions .btn-label { display: none; }
      }

      /* Presets + LUT rows */
      .preset-row {
        display: flex;
        gap: 0.4rem;
        align-items: stretch;
      }
      .preset-row .select { flex: 1 1 auto; min-width: 0; }
      .preset-row .btn { flex: 0 0 auto; padding: 0.4rem 0.7rem; font-size: 0.85rem; }
      .select {
        font: inherit;
        font-size: 0.9rem;
        padding: 0.45rem 0.6rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--fg);
        cursor: pointer;
      }
      .select:hover { border-color: var(--accent); }
      .select--block { width: 100%; margin-bottom: 0.5rem; }
      .hint {
        margin: 0.35rem 0 0;
        font-size: 0.75rem;
        color: var(--fg-muted, #888);
        line-height: 1.3;
      }
      #slider-lut-intensity { margin-top: 0.4rem; }
      #slider-lut-intensity.disabled,
      .slider.disabled input { opacity: 0.4; pointer-events: none; }

      /* History panel */
      #history-list { border: 1px solid #262626; border-radius: 6px; overflow: hidden; }
      .hist-entry {
        display: flex; align-items: center; gap: 8px;
        padding: 5px 8px; cursor: pointer; background: #141414;
        border-bottom: 1px solid #1e1e1e; transition: background 0.1s;
      }
      .hist-entry:last-child { border-bottom: none; }
      .hist-entry:hover { background: #1e1e1e; }
      .hist-entry.active { background: #1c3a5f; }
      .hist-entry.active .hist-label { color: #93c5fd; }
      .hist-time { font-size: 0.65rem; color: #555; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; white-space: nowrap; }
      .hist-label { font-size: 0.75rem; color: #ccc; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ── Tone Curve ───────────────────────────────── */
    .panel-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; }
    .channel-tabs { display:flex; gap:3px; }
    .ch-tab { padding:2px 7px; border:1px solid #444; border-radius:3px; background:#222; color:#888; cursor:pointer; font-size:11px; }
    .ch-tab.active { background:#4af; color:#111; border-color:#4af; font-weight:600; }
    .curve-container { display:flex; flex-direction:column; align-items:center; gap:5px; }
    #cv-svg { background:#171717; border:1px solid #333; border-radius:2px; cursor:crosshair; display:block; }
    .curve-actions { display:flex; align-items:center; gap:10px; }
    .cv-info { font-size:10px; color:#555; }
    .btn-sm { padding:2px 9px; font-size:11px; }

    /* ── Color Grading ─────────────────────────────── */
    .cg-details { margin-bottom: 6px; }
    .cg-details summary { cursor: pointer; padding: 4px 0; font-size: 12px; color: #aaa; }
    .cg-details summary:hover { color: #fafafa; }
    .cg-hsl-grid { display: flex; flex-direction: column; gap: 2px; margin-top: 4px; }
    .cg-hsl-row {
      display: grid;
      grid-template-columns: 14px 52px 1fr 1fr 1fr 20px 20px 20px;
      align-items: center;
      gap: 4px;
      font-size: 11px;
    }
    .cg-swatch { width: 14px; height: 14px; border-radius: 2px; flex-shrink: 0; }
    .cg-range-name { color: #888; font-size: 11px; white-space: nowrap; overflow: hidden; }
    .cg-hsl-slider { width: 100%; height: 4px; accent-color: #4af; cursor: pointer; }
    .cg-hsl-val { color: #555; font-size: 10px; text-align: center; }
    .cg-chan-label { font-size: 9px; color: #555; text-align: center; }
    .cg-hsl-header { display: grid; grid-template-columns: 14px 52px 1fr 1fr 1fr 20px 20px 20px; gap: 4px; font-size: 10px; color: #444; margin-top: 2px; }
    .cg-grading-section { display: flex; flex-direction: column; gap: 8px; margin-top: 6px; }
    .cg-wheel-row { display: flex; gap: 8px; justify-content: space-between; }
    .cg-wheel-group { display: flex; flex-direction: column; align-items: center; gap: 4px; flex: 1; }
    .cg-wheel-group label { font-size: 10px; color: #888; }
    .cg-color-wheel { width: 36px; height: 36px; border: 1px solid #333; border-radius: 4px; padding: 1px; background: #1a1a1a; cursor: pointer; }
    .cg-mode-row { display: flex; align-items: center; gap: 8px; font-size: 11px; color: #888; }
    .cg-mode-row select { background: #222; color: #fafafa; border: 1px solid #333; border-radius: 4px; padding: 2px 4px; font-size: 11px; }
    .cg-global-section { display: flex; gap: 8px; margin-top: 6px; }
    .cg-global-section .cg-wheel-group { flex-direction: row; align-items: center; }

    /* ── Effects (Split Toning, Grain) ──────────────────── */
    .fx-details { margin-bottom: 6px; }
    .fx-details summary { cursor: pointer; padding: 4px 0; font-size: 12px; color: #aaa; }
    .fx-details summary:hover { color: #fafafa; }
    .st-section { display: flex; flex-direction: column; gap: 2px; margin-top: 4px; }
    .st-subhead { font-size: 10px; color: #555; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 4px; }

    </style>
  </head>
  <body>
    <div class="editor">
      <header class="top">
        <div class="top-title">
          <a class="back-link" href={`/admin/galleries/${img.gallery_id}`}>← Back</a>
          <h1>{img.original_name}</h1>
          <span class="meta">{img.width}×{img.height} · {img.mime}</span>
        </div>
        <div class="top-actions">
          <button class="btn" id="btn-reset">Reset</button>
          <button class="btn btn--ghost btn-compare-pill" id="btn-compare" type="button" aria-label="Hold to compare original" title="Hold to compare original (or press SPACE)" aria-pressed="false">
            <svg class="compare-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <rect x="2" y="4" width="9" height="16" rx="1" fill="currentColor" opacity="0.55"/>
              <rect x="13" y="4" width="9" height="16" rx="1" fill="currentColor"/>
              <line x1="12" y1="2" x2="12" y2="22" stroke="currentColor" stroke-width="1.25" opacity="0.85"/>
            </svg>
          </button>
          <button class="btn btn--danger" id="btn-revert" disabled={!latestEdit}>Revert to original</button>
          <button class="btn btn--primary" id="btn-save">Save edit</button>
        </div>
      </header>

      <div class="canvas-area">
        <div class="canvas-wrap" id="canvas-wrap">
          <canvas id="preview"></canvas>
          <div id="vignette-overlay" class="vignette-overlay"></div>
          <div id="crop-overlay"></div>
          <div class="canvas-hint">Drag on the image to set a crop · Sliders adjust live · Save to bake it in</div>
        </div>
        <div class="zoom-controls" role="toolbar" aria-label="Zoom controls">
          <button data-zoom="fit" class="active" title="Fit to viewport">Fit</button>
          <button data-zoom="100" title="Actual size (1 source pixel per CSS pixel)">100%</button>
          <button data-zoom="200" title="2x zoom (click+drag to pan)">200%</button>
          <button data-zoom="400" title="4x zoom (click+drag to pan)">400%</button>
          <span class="zoom-hint" id="zoom-hint">⌘/Ctrl+wheel</span>
        </div>
      </div>

      <aside class="panel">
        <section class="panel-section" id="section-presets">
          <h3>Presets</h3>
          <div class="preset-row">
            <select id="preset-select" class="select select--block">
              <option value="">Choose preset…</option>
            </select>
            <button class="btn btn--ghost" id="btn-save-preset" type="button" title="Save current slider values + LUT as a named preset">Save</button>
          </div>
          <p class="hint" id="preset-hint">Built-in and your saved presets. Saved presets are tied to your admin account.</p>
        </section>

        <section class="panel-section" id="section-luts">
          <h3>Look</h3>
          <select id="lut-select" class="select select--block">
            <option value="">No LUT</option>
          </select>
          <div class="slider" data-key="lut_intensity" id="slider-lut-intensity">
            <label>Intensity</label>
            <input type="range" min="0" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <p class="hint">Built-in looks available to all accounts. Upload more from the admin panel.</p>
        </section>

        <section class="panel-section">
          <h3>Light <button id="btn-reset-light">reset</button> <button class="btn" id="btn-auto-tone" style="font-size:0.7rem;padding:0.2rem 0.5rem">Auto</button></h3>
          <div class="slider" data-key="exposure">
            <label>Exposure</label>
            <input type="range" min="-200" max="200" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="contrast">
            <label>Contrast</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="brightness">
            <label>Brightness</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <section class="panel-section">
          <h3>Tone <button id="btn-reset-tone">reset</button></h3>
          <div class="slider" data-key="highlights">
            <label>Highlights</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="shadows">
            <label>Shadows</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="whites">
            <label>Whites</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="blacks">
            <label>Blacks</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <section class="panel-section">
          <h3>Color <button id="btn-reset-color">reset</button></h3>
          <div class="slider" data-key="saturation">
            <label>Saturation</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="temp">
            <label>Temperature</label>
            <input type="range" min="-200" max="200" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="tint">
            <label>Tint</label>
            <input type="range" min="-200" max="200" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <!-- ── Tone Curve ─────────────────────────────────────── -->
        <section class="panel-section" id="section-curve">
          <h3 class="panel-heading">
            Tone Curve
            <div class="channel-tabs">
              <button class="ch-tab active" data-cvch="rgb">RGB</button>
              <button class="ch-tab" data-cvch="r">R</button>
              <button class="ch-tab" data-cvch="g">G</button>
              <button class="ch-tab" data-cvch="b">B</button>
            </div>
          </h3>
          <div class="curve-container">
            <svg id="cv-svg" width="220" height="220" viewBox="0 0 220 220">
              <defs>
                <linearGradient id="cvHistG" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#fff" stop-opacity="0.75"/>
                  <stop offset="100%" stop-opacity="0.02"/>
                </linearGradient>
              </defs>
              <line x1="10" y1="110" x2="210" y2="110" stroke="#444" stroke-width="0.5"/>
              <line x1="110" y1="10" x2="110" y2="210" stroke="#444" stroke-width="0.5"/>
              <line id="cv-identity" x1="10" y1="210" x2="210" y2="10" stroke="#666" stroke-width="1" stroke-dasharray="3,3"/>
              <path id="cv-hist" fill="url(#cvHistG)" stroke="none"/>
              <path id="cv-path" stroke="#4af" stroke-width="1.5" fill="none"/>
              <g id="cv-pts"></g>
            </svg>
            <div class="curve-actions">
              <button id="cv-reset" class="btn btn-ghost btn-sm">Reset</button>
              <span id="cv-info" class="cv-info"></span>
            </div>
          </div>
        </section>

        <section class="panel-section">
          <h3>Effects <button id="btn-reset-fx">reset</button></h3>
          <div class="slider" data-key="sharpen">
            <label>Sharpen</label>
            <input type="range" min="0" max="200" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="vignette">
            <label>Vignette</label>
            <input type="range" min="0" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="dehaze">
            <label>Dehaze</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>

          <details class="fx-details">
            <summary>Split Toning</summary>
            <div class="st-section">
              <div class="st-subhead">Shadows</div>
              <div class="slider" data-key="st_shadows_hue">
                <label>Hue</label>
                <input type="range" min="0" max="360" step="1" />
                <span class="val">0</span>
              </div>
              <div class="slider" data-key="st_shadows_saturation">
                <label>Saturation</label>
                <input type="range" min="0" max="100" step="1" />
                <span class="val">0</span>
              </div>
              <div class="st-subhead">Highlights</div>
              <div class="slider" data-key="st_highlights_hue">
                <label>Hue</label>
                <input type="range" min="0" max="360" step="1" />
                <span class="val">0</span>
              </div>
              <div class="slider" data-key="st_highlights_saturation">
                <label>Saturation</label>
                <input type="range" min="0" max="100" step="1" />
                <span class="val">0</span>
              </div>
              <div class="slider" data-key="st_balance">
                <label>Balance</label>
                <input type="range" min="-100" max="100" step="1" />
                <span class="val">0</span>
              </div>
            </div>
          </details>

          <details class="fx-details">
            <summary>Grain</summary>
            <div class="slider" data-key="grain_amount">
              <label>Amount</label>
              <input type="range" min="0" max="100" step="1" />
              <span class="val">0</span>
            </div>
            <div class="slider" data-key="grain_size">
              <label>Size</label>
              <input type="range" min="0" max="100" step="1" />
              <span class="val">25</span>
            </div>
          </details>
        </section>

        {isRaw && (
          <section class="panel-section" id="section-raw">
            <h3>RAW <button id="btn-reset-raw">reset</button></h3>
            <div class="raw-note">Live preview uses the cached JPEG approximation. Full RAW render on Save (via darktable-cli).</div>

            <div class="raw-subhead">White Balance</div>
            <div class="slider" data-key="raw_wb_kelvin">
              <label>Kelvin</label>
              <input type="range" min="2000" max="10000" step="50" />
              <span class="val">5500</span>
            </div>
            <div class="slider" data-key="raw_wb_tint">
              <label>Tint (M/G)</label>
              <input type="range" min="-100" max="100" step="1" />
              <span class="val">0</span>
            </div>

            <div class="raw-subhead">Noise Reduction</div>
            <div class="slider" data-key="raw_nr_lum">
              <label>Luminance</label>
              <input type="range" min="0" max="100" step="1" />
              <span class="val">0</span>
            </div>
            <div class="slider" data-key="raw_nr_chroma">
              <label>Chroma</label>
              <input type="range" min="0" max="100" step="1" />
              <span class="val">0</span>
            </div>

            <div class="raw-subhead">Lens</div>
            <div class="checkbox-row">
              <input type="checkbox" id="raw-lens-on" />
              <label for="raw-lens-on">Auto lens corrections</label>
              <span id="lens-corrections-badge" class="lens-badge" style="display:none">LENS ON</span>
            </div>
          </section>
        )}


        <section class="panel-section" id="section-color-grading">
          <h3>Color Grading <button id="btn-reset-cg">reset</button></h3>

          <details class="cg-details">
            <summary>HSL Mixer</summary>
            <div class="cg-hsl-grid">
              <div class="cg-hsl-row" data-range="red">
                <span class="cg-swatch" style="background:#ff0000"></span>
                <span class="cg-range-name">Red</span>
                <input type="range" class="cg-hsl-slider" data-range="red" data-channel="h" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="red" data-channel="s" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="red" data-channel="l" min="-100" max="100" step="1" value="0" />
                <span class="cg-hsl-val h">0</span>
                <span class="cg-hsl-val s">0</span>
                <span class="cg-hsl-val l">0</span>
              </div>
              <div class="cg-hsl-row" data-range="orange">
                <span class="cg-swatch" style="background:#ff8000"></span>
                <span class="cg-range-name">Orange</span>
                <input type="range" class="cg-hsl-slider" data-range="orange" data-channel="h" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="orange" data-channel="s" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="orange" data-channel="l" min="-100" max="100" step="1" value="0" />
                <span class="cg-hsl-val h">0</span>
                <span class="cg-hsl-val s">0</span>
                <span class="cg-hsl-val l">0</span>
              </div>
              <div class="cg-hsl-row" data-range="yellow">
                <span class="cg-swatch" style="background:#ffff00"></span>
                <span class="cg-range-name">Yellow</span>
                <input type="range" class="cg-hsl-slider" data-range="yellow" data-channel="h" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="yellow" data-channel="s" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="yellow" data-channel="l" min="-100" max="100" step="1" value="0" />
                <span class="cg-hsl-val h">0</span>
                <span class="cg-hsl-val s">0</span>
                <span class="cg-hsl-val l">0</span>
              </div>
              <div class="cg-hsl-row" data-range="green">
                <span class="cg-swatch" style="background:#00ff00"></span>
                <span class="cg-range-name">Green</span>
                <input type="range" class="cg-hsl-slider" data-range="green" data-channel="h" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="green" data-channel="s" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="green" data-channel="l" min="-100" max="100" step="1" value="0" />
                <span class="cg-hsl-val h">0</span>
                <span class="cg-hsl-val s">0</span>
                <span class="cg-hsl-val l">0</span>
              </div>
              <div class="cg-hsl-row" data-range="aqua">
                <span class="cg-swatch" style="background:#00ffff"></span>
                <span class="cg-range-name">Aqua</span>
                <input type="range" class="cg-hsl-slider" data-range="aqua" data-channel="h" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="aqua" data-channel="s" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="aqua" data-channel="l" min="-100" max="100" step="1" value="0" />
                <span class="cg-hsl-val h">0</span>
                <span class="cg-hsl-val s">0</span>
                <span class="cg-hsl-val l">0</span>
              </div>
              <div class="cg-hsl-row" data-range="blue">
                <span class="cg-swatch" style="background:#0000ff"></span>
                <span class="cg-range-name">Blue</span>
                <input type="range" class="cg-hsl-slider" data-range="blue" data-channel="h" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="blue" data-channel="s" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="blue" data-channel="l" min="-100" max="100" step="1" value="0" />
                <span class="cg-hsl-val h">0</span>
                <span class="cg-hsl-val s">0</span>
                <span class="cg-hsl-val l">0</span>
              </div>
              <div class="cg-hsl-row" data-range="purple">
                <span class="cg-swatch" style="background:#8000ff"></span>
                <span class="cg-range-name">Purple</span>
                <input type="range" class="cg-hsl-slider" data-range="purple" data-channel="h" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="purple" data-channel="s" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="purple" data-channel="l" min="-100" max="100" step="1" value="0" />
                <span class="cg-hsl-val h">0</span>
                <span class="cg-hsl-val s">0</span>
                <span class="cg-hsl-val l">0</span>
              </div>
              <div class="cg-hsl-row" data-range="magenta">
                <span class="cg-swatch" style="background:#ff00ff"></span>
                <span class="cg-range-name">Magenta</span>
                <input type="range" class="cg-hsl-slider" data-range="magenta" data-channel="h" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="magenta" data-channel="s" min="-100" max="100" step="1" value="0" />
                <input type="range" class="cg-hsl-slider" data-range="magenta" data-channel="l" min="-100" max="100" step="1" value="0" />
                <span class="cg-hsl-val h">0</span>
                <span class="cg-hsl-val s">0</span>
                <span class="cg-hsl-val l">0</span>
              </div>
              <div class="cg-hsl-header">
                <span></span><span></span>
                <span class="cg-chan-label">H</span><span class="cg-chan-label">S</span><span class="cg-chan-label">L</span>
              </div>
            </div>
          </details>

          <details class="cg-details">
            <summary>Color Grading</summary>
            <div class="cg-grading-section">
              <div class="cg-wheel-row">
                <div class="cg-wheel-group">
                  <label>Shadows</label>
                  <input type="color" class="cg-color-wheel" id="cg-shadows-colour" value="#000000" />
                  <div class="slider" data-key="cg_shadows_intensity">
                    <input type="range" min="0" max="100" step="1" value="0" />
                    <span class="val">0</span>
                  </div>
                </div>
                <div class="cg-wheel-group">
                  <label>Midtones</label>
                  <input type="color" class="cg-color-wheel" id="cg-midtones-colour" value="#000000" />
                  <div class="slider" data-key="cg_midtones_intensity">
                    <input type="range" min="0" max="100" step="1" value="0" />
                    <span class="val">0</span>
                  </div>
                </div>
                <div class="cg-wheel-group">
                  <label>Highlights</label>
                  <input type="color" class="cg-color-wheel" id="cg-highlights-colour" value="#000000" />
                  <div class="slider" data-key="cg_highlights_intensity">
                    <input type="range" min="0" max="100" step="1" value="0" />
                    <span class="val">0</span>
                  </div>
                </div>
              </div>
              <div class="cg-mode-row">
                <label>Mode</label>
                <select id="cg-mode-select">
                  <option value="saturation">Saturation</option>
                  <option value="luminance">Luminance</option>
                </select>
              </div>
            </div>
          </details>

          <details class="cg-details">
            <summary>Global</summary>
            <div class="cg-global-section">
              <div class="cg-wheel-group">
                <input type="color" class="cg-color-wheel" id="cg-global-colour" value="#000000" />
                <div class="slider" data-key="cg_global_intensity">
                  <input type="range" min="0" max="100" step="1" value="0" />
                  <span class="val">0</span>
                </div>
              </div>
            </div>
          </details>
        </section>


        <section class="panel-section" id="section-history">
          <h3>
            History
            <div style="display:flex;gap:4px">
              <button class="btn" id="btn-history-undo" title="Undo (Ctrl+Z)" disabled>&#x21A9 Undo</button>
              <button class="btn" id="btn-history-redo" title="Redo (Ctrl+Shift+Z)" disabled>&#x21AA Redo</button>
            </div>
          </h3>
          <div id="history-list" style="max-height:160px;overflow-y:auto;font-size:0.75rem;display:flex;flex-direction:column;gap:1px"></div>
        </section>

        <section class="panel-section">
          <h3>Crop</h3>
          <div class="crop-buttons">
            <button class="btn" data-aspect="free">Free</button>
            <button class="btn" data-aspect="1:1">1:1</button>
            <button class="btn" data-aspect="4:3">4:3</button>
            <button class="btn" data-aspect="3:2">3:2</button>
            <button class="btn" data-aspect="16:9">16:9</button>
            <button class="btn" id="btn-clear-crop">Clear</button>
          </div>
          <div class="slider" data-key="straighten" style="margin-top:0.5rem">
            <label>Straighten</label>
            <input type="range" min="-45" max="45" step="0.5" />
            <span class="val">0</span>
          </div>
          <div style="display:flex;gap:0.4rem;align-items:center;margin-top:0.4rem">
            <input type="text" id="crop-aspect-input" placeholder="e.g. 4:5, 2.39:1" style="flex:1;background:#1a1a1a;border:1px solid #333;color:#fafafa;border-radius:5px;padding:0.3rem 0.5rem;font-size:0.75rem" />
            <button class="btn" id="btn-apply-aspect" style="padding:0.3rem 0.6rem;font-size:0.75rem">Apply</button>
          </div>
          <div id="crop-dims" style="font-size:0.7rem;color:#888;margin-top:0.3rem;font-family:ui-monospace,SFMono-Regular,Menlo,monospace"></div>
        </section>

        <div class="status" id="status">Ready.</div>
        {(exif.camera || exif.lens || exif.iso || exif.aperture || exif.shutter || exif.focalLength || exif.takenAt) && (
          <div class="exif" title="Photo EXIF metadata">
            {exif.camera && (
              <span class="exif__item exif__camera"><span class="exif__k">Camera</span><span class="exif__v">{exif.camera}</span></span>
            )}
            {exif.lens && (
              <span class="exif__item"><span class="exif__k">Lens</span><span class="exif__v">{exif.lens}</span></span>
            )}
            {exif.iso && (
              <span class="exif__item"><span class="exif__k">ISO</span><span class="exif__v">{exif.iso}</span></span>
            )}
            {exif.aperture && (
              <span class="exif__item"><span class="exif__k">Aperture</span><span class="exif__v">{exif.aperture}</span></span>
            )}
            {exif.shutter && (
              <span class="exif__item"><span class="exif__k">Shutter</span><span class="exif__v">{exif.shutter}</span></span>
            )}
            {exif.focalLength && (
              <span class="exif__item"><span class="exif__k">Focal</span><span class="exif__v">{exif.focalLength}</span></span>
            )}
            {exif.takenAt && (
              <span class="exif__item"><span class="exif__k">Taken</span><span class="exif__v">{exif.takenAt.replace('T', ' ').replace(/\..*$/, '').replace('Z', ' UTC')}</span></span>
            )}
          </div>
        )}
      </aside>
    </div>

    <div class="toast" id="toast"></div>
    <div id="compare-indicator" class="compare-indicator">ORIGINAL</div>

    <script type="module" define:vars={{
      imageId: img.id,
      sourceUrl,
      initialParams,
      hasExistingEdit: !!latestEdit,
      RAW_DEFAULTS,
      RAW_KEYS,
      rawPreviewEnabled,
    }}>

      // ---- Canvas 2D editor ----
      // Phase A: live preview via CSS filter on a Canvas 2D context.
      // Phase B-ready: Save sends params + crop to server which renders
      // at full resolution with sharp and writes the JPG to /uploads/edits/{id}/.
      // The original file is NEVER touched.
      const statusEl = document.getElementById('status');
      const btnSave = document.getElementById('btn-save');
      const btnRevert = document.getElementById('btn-revert');
      const btnReset = document.getElementById('btn-reset');

      // ---- Canvas setup with optional WebGL2 GPU pipeline ----
      // We must grab the right context type BEFORE any other code touches
      // the canvas — a canvas can hold only ONE rendering context. The
      // previous integration attempt failed because the live #preview canvas
      // had already been touched by a 2D getContext() call (or had its
      // framebuffer dimensions changed via CSS resize) before WebGL2 was
      // allocated, producing a black-output framebuffer. The fix: clone
      // the canvas, replace it in the DOM, and grab the context on the
      // fresh clone.
      const _origCanvas = document.getElementById('preview');
      const canvas = _origCanvas.cloneNode(false);
      _origCanvas.parentNode.replaceChild(canvas, _origCanvas);

      let ctx = null;
      let webglPipeline = null;
      let useWebGL = false;

      // Probe WebGL2 first.
      const _gl2 = canvas.getContext('webgl2', {
        alpha: false, antialias: false, depth: false, stencil: false,
        preserveDrawingBuffer: false, premultipliedAlpha: false,
      });

      if (_gl2) {
        // WebGL2 is available. Pipeline will be lazily loaded on first draw.
        useWebGL = true;
      } else {
        // Fall back to 2D context.
        ctx = canvas.getContext('2d', { alpha: false });
        if (!ctx) {
          statusEl.textContent = 'Canvas 2D not supported in this browser.';
          statusEl.classList.add('error');
          throw new Error('no 2d ctx');
        }
        ctx.imageSmoothingEnabled = true;
        if ('imageSmoothingQuality' in ctx) {
          ctx.imageSmoothingQuality = 'high';
        }
      }

      // ---- Lazy WebGL pipeline loader ----
      // Loaded on first WebGL draw. The pipeline module is served from
      // /_webgl-pipeline.js (bundled from src/lib/editor-gl.ts). We use
      // dynamic import + blob URL so the bundle is fetched once and
      // cached by the browser.
      let _drawPipelineLoading = null;
      async function loadWebGLPipeline() {
        if (webglPipeline !== null && webglPipeline !== false) return webglPipeline;
        if (!_drawPipelineLoading) {
          _drawPipelineLoading = (async () => {
            try {
              const res = await fetch('/_webgl-pipeline.js');
              if (!res.ok) throw new Error('pipeline not served');
              const code = await res.text();
              const blob = new Blob([code], { type: 'application/javascript' });
              const url = URL.createObjectURL(blob);
              const mod = await import(/* @vite-ignore */ url);
              if (typeof mod.createWebGLPipeline !== 'function') throw new Error('bad module');
              const p = mod.createWebGLPipeline();
              if (!p || !p.init(canvas)) throw new Error('init returned false');
              return p;
            } catch (e) {
              console.warn('WebGL pipeline load failed:', e);
              return false;
            }
          })();
        }
        const result = await _drawPipelineLoading;
        webglPipeline = result;
        return webglPipeline;
      }

      const state = { ...initialParams };
      // Lookup from LUT id → parsed { size, data: Uint8Array }
      const lutCache = new Map();
      let activeLut = null;  // { size, data } once loaded; null = no LUT pass
      const sourceImage = new Image();
      sourceImage.crossOrigin = 'anonymous';
      // Apply CSS preview approximation for RAW sliders that have no
      // direct JPEG equivalent (denoise blur, lens brightness lift).
      // Helper is defined later in the script — wrap in DOMContentLoaded.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          if (typeof applyRawPreviewFx === 'function') applyRawPreviewFx();
        });
      }

      // iOS Safari / WKWebView silently ignores ctx.filter on canvas
      // drawImage in many versions. Toggle the live-preview pipeline
      // accordingly so the sliders actually respond on iPhone. Desktop
      // and Chromium Android keep the fast GPU filter path.
      const isIOS = (typeof navigator !== 'undefined') && (
        /iPad|iPhone|iPod/.test(navigator.userAgent) ||
        (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
      );

      function setStatus(msg, isErr) {
        statusEl.textContent = msg;
        statusEl.classList.toggle('error', !!isErr);
        statusEl.classList.toggle('ok', !isErr);
      }

      function computeFilters(opts) {
        const s = state;
        // Allow caller to override temp/tint for RAW preview approximation
        const previewTemp = (opts && opts.temp != null) ? opts.temp : s.temp;
        const previewTint = (opts && opts.tint != null) ? opts.tint : s.tint;
        const f = [];
        // Exposure (-200..200) — divide by 100 = stops. Only push if non-zero;
        // neutral (1.000) still triggers a GPU filter pass which can introduce
        // sub-LSB rounding over many passes.
        const exposureStops = s.exposure / 100;
        const expBrightness = Math.pow(2, exposureStops);  // 1 at 0, ~0.25..4 otherwise
        if (s.exposure !== 0) f.push('brightness(' + expBrightness.toFixed(3) + ')');
        // Contrast (-100..100) — 0 = neutral, +/- = contrast change. Skip if 0.
        if (s.contrast !== 0) f.push('contrast(' + (100 + s.contrast) + '%)');
        // Saturation (-100..100) — skip if 0.
        if (s.saturation !== 0) f.push('saturate(' + (100 + s.saturation) + '%)');
        // Brightness (-100..100) additive on top of exposure. Skip if 0.
        if (s.brightness !== 0) f.push('brightness(' + (100 + s.brightness) + '%)');
        // WB Temp (-100..100): warmer (positive) = sepia-ish; cooler = hue-rotate -ve
        if (previewTemp > 0) f.push('sepia(' + Math.min(100, previewTemp * 40) + '%)');
        else if (previewTemp < 0) f.push('hue-rotate(' + Math.max(-180, previewTemp * 30) + 'deg)');
        // Tint (-100..100): green vs magenta
        if (previewTint > 0) f.push('hue-rotate(' + Math.min(90, previewTint * 30) + 'deg)');
        // Shadows/Highlights/Whites/Blacks: stacked contrast tweak (rough)
        const shadowBoost = s.shadows / 100;       // negative darkens, positive lifts
        const highlightCut = s.highlights / 100;   // negative darkens, positive lifts
        if (s.shadows !== 0 || s.highlights !== 0) {
          // Approximate via a contrast/brightness combo
          const tones = (highlightCut - shadowBoost) * 0.2;
          f.push('contrast(' + (100 + tones * 20) + '%)');
          f.push('brightness(' + (100 + (shadowBoost + highlightCut) * 8) + '%)');
        }
        if (s.whites !== 0 || s.blacks !== 0) {
          // Endpoints — push contrast + slight brightness
          const ends = (s.whites - s.blacks) / 100;
          f.push('contrast(' + (100 + ends * 12) + '%)');
        }
        // Sharpen is now handled OUTSIDE the CSS filter chain via Canvas 2D
        // unsharp-mask in getSharpenedSource(). See below.
        return f.join(' ');
      }

      // ---- Unsharp mask via Canvas 2D ----
      // The previous SVG feConvolveMatrix approach broke (the rendered result
      // was going pure black). This is the textbook unsharp-mask recipe:
      //   1. Render source to off-screen canvas
      //   2. Apply Gaussian blur to a copy -> blurredData
      //   3. For each pixel: out = clamp( src + (src - blurred) * amount )
      // amount is 0..1 derived from slider 0..100. At amount=0 we just
      // return sourceImage (no extra work). Result: brightening of edges,
      // never pure-black. Cached so we only re-blur when amount changes.
      const _sharpenCanvas = document.createElement('canvas');
      const _sharpenCtx = _sharpenCanvas.getContext('2d');
      let _sharpenCacheKey = -1;
      let _sharpenCacheCanvas = null;

      // rAF coalescing. Slider 'input' events fire 60+ times per second.
      // Running draw() on every event oversubscribes the pipeline (especially
      // the 250ms LUT pass on a 4K source). ScheduleDraw() collapses multiple
      // events within a single animation frame to one draw call.
      let _drawScheduled = false;
      function scheduleDraw() {
        if (_drawScheduled) return;
        _drawScheduled = true;
        requestAnimationFrame(() => {
          _drawScheduled = false;
          draw();
        });
      }

      function getSharpenedSource(amount) {
        if (!sourceImage.complete || !sourceImage.naturalWidth) return sourceImage;
        if (amount <= 0) return sourceImage;
        if (amount === _sharpenCacheKey && _sharpenCacheCanvas) return _sharpenCacheCanvas;

        const w = canvas.width;
        const h = canvas.height;
        _sharpenCanvas.width = w;
        _sharpenCanvas.height = h;

        // 1. Draw sharp source
        _sharpenCtx.clearRect(0, 0, w, h);
        _sharpenCtx.drawImage(sourceImage, 0, 0, w, h);
        const sharpImg = _sharpenCtx.getImageData(0, 0, w, h);

        // 2. Blur via a per-pixel 3x3 box blur (two passes — horizontal +
        //    vertical — approximate a Gaussian sigma ≈ 1.2px). Required
        //    because ctx.filter = 'blur(1.2px)' silently fails on iOS
        //    Safari / WKWebView (same root cause as the live-preview
        //    slider bug). On desktop this is slightly slower than the
        //    native CSS blur but visually indistinguishable.
        const sw = sharpImg.width, sh = sharpImg.height;
        const sd = sharpImg.data;
        const tmp = new Uint8ClampedArray(sd.length);
        // Horizontal pass: 3-tap box into tmp
        for (let y = 0; y < sh; y++) {
          const row = y * sw * 4;
          for (let x = 0; x < sw; x++) {
            const i = row + x * 4;
            let r = 0, g = 0, b = 0, c = 0;
            for (let dx = -1; dx <= 1; dx++) {
              const nx = x + dx;
              if (nx < 0 || nx >= sw) continue;
              const ni = row + nx * 4;
              r += sd[ni]; g += sd[ni + 1]; b += sd[ni + 2]; c++;
            }
            tmp[i] = r / c; tmp[i + 1] = g / c; tmp[i + 2] = b / c; tmp[i + 3] = sd[i + 3];
          }
        }
        // Vertical pass: 3-tap box into a SEPARATE buffer so the original
        // pixel data in sharpImg.data stays intact for the unsharp-mask
        // subtraction below. (Earlier this wrote back into sharpImg.data,
        // which clobbered the original and produced a blurred output
        // instead of sharpened.)
        const blur = new Uint8ClampedArray(sd.length);
        for (let y = 0; y < sh; y++) {
          for (let x = 0; x < sw; x++) {
            const i = (y * sw + x) * 4;
            let r = 0, g = 0, b = 0, c = 0;
            for (let dy = -1; dy <= 1; dy++) {
              const ny = y + dy;
              if (ny < 0 || ny >= sh) continue;
              const ni = (ny * sw + x) * 4;
              r += tmp[ni]; g += tmp[ni + 1]; b += tmp[ni + 2]; c++;
            }
            blur[i] = r / c; blur[i + 1] = g / c; blur[i + 2] = b / c; blur[i + 3] = tmp[i + 3];
          }
        }

        // 3. Unsharp mask: out = src + (src - blur) * amount
        const k = amount / 100;  // 0..1
        for (let i = 0; i < sd.length; i += 4) {
          const dr = sd[i]   - blur[i];
          const dg = sd[i+1] - blur[i + 1];
          const db = sd[i + 2] - blur[i + 2];
          let r = sd[i]   + dr * k;
          let g = sd[i+1] + dg * k;
          let b = sd[i+2] + db * k;
          if (r < 0) r = 0; else if (r > 255) r = 255;
          if (g < 0) g = 0; else if (g > 255) g = 255;
          if (b < 0) b = 0; else if (b > 255) b = 255;
          sd[i] = r; sd[i+1] = g; sd[i+2] = b;
        }
        _sharpenCtx.putImageData(sharpImg, 0, 0);
        _sharpenCacheKey = amount;
        _sharpenCacheCanvas = _sharpenCanvas;
        return _sharpenCanvas;
      }

      // Invalidate sharpen cache when source image changes
      const _origSourceAssign = sourceImage.src;
      sourceImage.addEventListener('load', () => {
        _sharpenCacheKey = -1;
        _sharpenCacheCanvas = null;
      });

      // Apply vignette overlay opacity (separate from canvas filter — vignette is a DOM overlay)
      const vignetteEl = document.getElementById('vignette-overlay');
      function applyVignetteOverlay() {
        // In WebGL mode the shader handles vignette accurately (matching
        // server-side save), so the DOM overlay stays hidden. In legacy
        // (iOS) mode the DOM overlay is the preview.
        if (useWebGL) { vignetteEl.style.opacity = '0'; return; }
        const v = Number(state.vignette) || 0;
        if (v <= 0) { vignetteEl.style.opacity = '0'; return; }
        // 0..100 → 0..0.85 opacity
        const o = Math.max(0.05, Math.min(0.85, v / 100 * 0.85));
        vignetteEl.style.opacity = String(o);
      }
      window.applyVignetteOverlay = applyVignetteOverlay;

      // Sharpen is now handled via getSharpenedSource() below — unsharp-mask
      // in plain Canvas 2D pixel ops, no SVG filter dependency.

      // Maximum canvas backing buffer dimension. We render at NATIVE source
      // resolution always — never downsample at the canvas blit stage, because
      // browser drawImage's bilinear downsample loses detail before CSS gets
      // a chance to do its high-quality GPU downsample for display. The
      // browser's CSS compositor is much better at the final downsample than
      // canvas drawImage is at mid-res resampling.
      //
      // Trade-off: the per-pixel pipeline (sharpen + LUT) runs at native res.
      // For a 6000x4000 source that's ~24M pixels; desktop CPU handles the
      // slider pass at ~200-500ms/frame, sharpen cache first build at ~1-2s,
      // trilinear LUT apply at ~500-800ms. iOS Safari at native res = ~1-2s
      // per slider touch — sluggish but functional. The fast path skips all
      // of this for the 'just looking' case.
      const MAX_CANVAS_DIM = 16384;  // effectively no cap; covers any sane camera

      // Zoom state. 'fit' = current behaviour (backing matches display size,
      // no jaggies). 100/200/400 = backing = source * (zoom/100), CSS-sized
      // the same, canvas positioned absolutely with pan offsets for panning.
      // Persisted per-image via URL hash (#z=fit or #z=100 etc.).
      let zoomMode = 'fit';
      let panX = 0, panY = 0;
      const ZOOM_STORAGE_KEY = 'snappydo:zoom:';

      function loadZoomFromHash() {
        try {
          const m = location.hash.match(/z=(fit|100|200|400)/);
          if (m) return m[1];
          const saved = localStorage.getItem(ZOOM_STORAGE_KEY + imageId);
          if (saved && ['fit', '100', '200', '400'].includes(saved)) return saved;
        } catch (e) { /* localStorage may be blocked */ }
        return 'fit';
      }
      function saveZoom(mode) {
        try { localStorage.setItem(ZOOM_STORAGE_KEY + imageId, mode); } catch (e) {}
        // Also reflect in URL hash so it's shareable / survives reload.
        if (mode === 'fit') {
          history.replaceState(null, '', location.pathname);
        } else {
          history.replaceState(null, '', location.pathname + '#z=' + mode);
        }
      }

      function setZoom(mode, opts) {
        if (!['fit', '100', '200', '400'].includes(mode)) return;
        zoomMode = mode;
        saveZoom(mode);
        // Reset pan when switching modes (zoom-to-fit starts centred).
        panX = 0; panY = 0;
        // Update toolbar active state
        document.querySelectorAll('.zoom-controls button').forEach(b => {
          b.classList.toggle('active', b.dataset.zoom === mode);
        });
        // Toggle canvas-wrap zoomed class so CSS positions the canvas absolutely.
        const wrap = document.getElementById('canvas-wrap');
        if (wrap) wrap.classList.toggle('zoomed', mode !== 'fit');
        fitCanvasToArea();
        draw();
        if (!opts || !opts.silent) {
          const ztxt = mode === 'fit' ? 'fit-to-screen' : mode + '%';
          setStatus('Zoom: ' + ztxt + '.');
        }
      }

      function fitCanvasToArea() {
        const area = document.querySelector('.canvas-area');
        const aw = area ? area.clientWidth : window.innerWidth;
        const ah = area ? area.clientHeight : window.innerHeight;
        if (!sourceImage.width) return;

        let bw, bh;
        if (zoomMode === 'fit') {
          // Fit-to-viewport (default). Backing = display size, no CSS-stage
          // scale, no aliasing (commit 0dfc143).
          const dispScale = Math.min(aw / sourceImage.width, ah / sourceImage.height, 1);
          bw = Math.max(1, Math.round(sourceImage.width * dispScale));
          bh = Math.max(1, Math.round(sourceImage.height * dispScale));
          canvas.width = bw;
          canvas.height = bh;
          canvas.style.width = bw + 'px';
          canvas.style.height = bh + 'px';
          canvas.style.transform = '';
          canvas.style.position = '';
        } else {
          // Zoom mode. KEY PERFORMANCE FIX: backing buffer stays at SOURCE
          // resolution, CSS transform: scale(z) applies the visual zoom.
          // Pipeline (drawImage, sharpen, sliders, LUT) processes the same
          // pixel count at all zoom levels — sliders stay as responsive as
          // at 100%. CSS upscale is GPU bilinear interpolation: smooth
          // (upsampling doesn't alias, only downsampling does).
          bw = sourceImage.width;
          bh = sourceImage.height;
          canvas.width = bw;
          canvas.height = bh;
          canvas.style.width = bw + 'px';
          canvas.style.height = bh + 'px';
          const z = parseInt(zoomMode, 10) / 100;
          // Pan offsets are in CSS pixels (after the transform). Centring
          // on first zoom-in positions the source at the centre of the
          // viewport at this zoom level.
          if (panX === 0 && panY === 0) {
            const visW = bw * z;
            const visH = bh * z;
            panX = Math.round((aw - visW) / 2);
            panY = Math.round((ah - visH) / 2);
          }
          // Clamp pan so canvas doesn't slide entirely off-screen.
          const visW = bw * z;
          const visH = bh * z;
          panX = Math.max(Math.min(panX, 32), Math.min(aw - visW - 32, 0));
          panY = Math.max(Math.min(panY, 32), Math.min(ah - visH - 32, 0));
          canvas.style.transformOrigin = '0 0';
          canvas.style.transform = 'translate(' + panX + 'px,' + panY + 'px) scale(' + z + ')';
        }
        // Hint the canvas blit / CSS scale to use the highest-quality resampler.
        // Skip when ctx is null (WebGL path owns the canvas).
        if (ctx && ctx.imageSmoothingQuality !== undefined) {
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
        }
      }

      // Apply LUT in pixel space (RGBA buffer in place). Shared by
      // desktop (post-ctx.filter) and iOS (per-pixel pipeline).
      //
      // Trilinear interpolation: for each input RGB, float-coords into the
      // 3D LUT cube, sample 8 corner cells, blend by (1-dx)(1-dy)(1-dz)
      // weights. Smooth gradients across the cube instead of nearest-cell
      // stair-stepping. Costs ~8x the memory reads but output stays in 8-bit
      // (final `.5 | 0` quantize). For 4K canvas = ~88M lookups, ~250ms on
      // desktop, ~1s on iOS Safari — acceptable.
      function applyLutToRgba(lut, data, mix) {
        const size = lut.size;
        const lutData = lut.data;
        const fs = size - 1;
        // 256 / (size-1) maps uint8 [0..255] to float [0..size-1].
        const inv = fs / 255;
        for (let i = 0; i < data.length; i += 4) {
          const r = data[i], g = data[i + 1], b = data[i + 2];
          // Float position in cube space
          const rf = r * inv;
          const gf = g * inv;
          const bf = b * inv;
          // Lower cube corner
          const r0 = rf | 0, g0 = gf | 0, b0 = bf | 0;
          const r1 = Math.min(size - 1, r0 + 1);
          const g1 = Math.min(size - 1, g0 + 1);
          const b1 = Math.min(size - 1, b0 + 1);
          // Sub-cell interpolation weights
          const dr = rf - r0;
          const dg = gf - g0;
          const db = bf - b0;
          // Sample 8 corners (still 8-bit values). Index = ((b*size+g)*size+r)*3.
          const i000 = ((b0 * size + g0) * size + r0) * 3;
          const i100 = ((b0 * size + g0) * size + r1) * 3;
          const i010 = ((b0 * size + g1) * size + r0) * 3;
          const i110 = ((b0 * size + g1) * size + r1) * 3;
          const i001 = ((b1 * size + g0) * size + r0) * 3;
          const i101 = ((b1 * size + g0) * size + r1) * 3;
          const i011 = ((b1 * size + g1) * size + r0) * 3;
          const i111 = ((b1 * size + g1) * size + r1) * 3;
          // Trilinear blend (lerp each channel independently)
          const w000 = (1 - dr) * (1 - dg) * (1 - db);
          const w100 = dr       * (1 - dg) * (1 - db);
          const w010 = (1 - dr) * dg       * (1 - db);
          const w110 = dr       * dg       * (1 - db);
          const w001 = (1 - dr) * (1 - dg) * db;
          const w101 = dr       * (1 - dg) * db;
          const w011 = (1 - dr) * dg       * db;
          const w111 = dr       * dg       * db;
          // Float output (still uint8-channel-space, no quantize yet)
          const ro = lutData[i000]     * w000 + lutData[i100]     * w100 +
                     lutData[i010]     * w010 + lutData[i110]     * w110 +
                     lutData[i001]     * w001 + lutData[i101]     * w101 +
                     lutData[i011]     * w011 + lutData[i111]     * w111;
          const go = lutData[i000 + 1] * w000 + lutData[i100 + 1] * w100 +
                     lutData[i010 + 1] * w010 + lutData[i110 + 1] * w110 +
                     lutData[i001 + 1] * w001 + lutData[i101 + 1] * w101 +
                     lutData[i011 + 1] * w011 + lutData[i111 + 1] * w111;
          const bo = lutData[i000 + 2] * w000 + lutData[i100 + 2] * w100 +
                     lutData[i010 + 2] * w010 + lutData[i110 + 2] * w110 +
                     lutData[i001 + 2] * w001 + lutData[i101 + 2] * w101 +
                     lutData[i011 + 2] * w011 + lutData[i111 + 2] * w111;
          // Mix with original at slider intensity
          const imix = 1 - mix;
          data[i]     = (r * imix + ro * mix + 0.5) | 0;
          data[i + 1] = (g * imix + go * mix + 0.5) | 0;
          data[i + 2] = (b * imix + bo * mix + 0.5) | 0;
        }
      }

      // ---- Web Worker for LUT pass ----
      // The trilinear LUT pass is ~250ms on a 4K source (15.8M pixels x 8
      // cube corners). Running it on the main thread blocks input. Move it
      // to a worker — main thread stays responsive, worker crunches pixels
      // in the background. The bytes move via Transferable (no clone).
      let lutWorker = null;
      let lutWorkerToken = 0; // incremented per request, used to discard stale results
      let lutWorkerResolve = null;
      function ensureLutWorker() {
        if (lutWorker) return lutWorker;
        const code = `
          let lutData = null;
          let lutSize = 0;
          self.onmessage = (e) => {
            const msg = e.data;
            if (msg.kind === 'lut') {
              lutData = msg.data;
              lutSize = msg.size;
              return;
            }            if (msg.kind === 'apply') {
              if (!lutData) { self.postMessage({ kind: 'done', token: msg.token, error: 'no LUT' }); return; }
              const data = msg.data;
              const size = lutSize;
