          cropBox.h = Math.max(2, p.y - cropBox.y);
        } else if (dragMode === 'nw') {
          cropBox.w += cropBox.x - p.x; cropBox.h += cropBox.y - p.y;
          cropBox.x = p.x; cropBox.y = p.y;
        } else if (dragMode === 'ne') {
          cropBox.w = Math.max(2, p.x - cropBox.x);
          cropBox.h += cropBox.y - p.y; cropBox.y = p.y;
        } else if (dragMode === 'sw') {
