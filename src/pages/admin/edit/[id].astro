---
/**
 * Image editor — single-image Lightroom-feel colour grading + crop.
 *
 * Pipeline:
 *   1. Load image at full resolution from imgproxy (or original)
 *   2. Paint to <canvas> via WebGL fragment shader (all adjustments)
 *   3. User adjusts sliders → uniform updates → instant preview
 *   4. Crop rectangle drawn as overlay; if set, fragment shader remaps UV
 *   5. On Save: render at NATIVE resolution via canvas.toBlob('image/jpeg', 0.95)
 *      → POST to /api/images/:id/edit
 *      → server stores at /uploads/edits/{id}/edit-{ts}.jpg + image_edits row
 *   6. Originals are NEVER touched
 *
 * Auth: middleware-protected (admin only).
 */
import { getImage } from '../../../lib/db';
import { adaptImage } from '../../../lib/image-adapter';
import { getLatestImageEdit, listImageEdits } from '../../../lib/db-image-edits';
import { imgproxyUrl } from '../../../lib/imgproxy';

export const prerender = false;

const id = Number(Astro.params.id);
const img = Number.isFinite(id) ? getImage(id) : undefined;
if (!img) return Astro.redirect('/admin', 302);

const latestEdit = getLatestImageEdit(id);
const initialParams = latestEdit ? JSON.parse(latestEdit.params_json) : {
  exposure: 0, contrast: 0, saturation: 0, brightness: 0,
  highlights: 0, shadows: 0, whites: 0, blacks: 0,
  temp: 0, tint: 0, sharpen: 0, vignette: 0,
  crop: null, // { x, y, w, h } in 0..1 UV space, or null
};

// Source URL — use the original file directly so we get full resolution.
// imgproxy's "no resize" passthrough would be ideal but can be slow on large files.
// The full-resolution URL via imgproxy: format=jpg, quality=95, no width cap.
const sourceUrl = `/api/images/${img.id}/source`;
      // Same-origin endpoint with CORS headers; keeps the WebGL canvas un-tainted
      // so canvas.toBlob() works on Save. imgproxy's URLs are cross-origin
      // (host:8090 vs the editor on host:3010) and don't ship CORS, which
      // silently fails <img crossorigin="anonymous">.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit — {img.original_name}</title>
    <style>
      :root {
        --bg: #0a0a0a;
        --panel: #141414;
        --panel-2: #1a1a1a;
        --border: #262626;
        --text: #fafafa;
        --muted: #888;
        --accent: #fafafa;
        --accent-bg: #fafafa;
        --accent-fg: #0a0a0a;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 14px;
        overflow: hidden;
      }
      .editor {
        display: grid;
        grid-template-columns: 1fr 360px;
        grid-template-rows: 56px 1fr;
        grid-template-areas:
          "top top"
          "canvas panel";
        height: 100vh;
      }
      .top {
        grid-area: top;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1rem;
        background: var(--panel);
        border-bottom: 1px solid var(--border);
        gap: 1rem;
      }
      .top-title {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.875rem;
        min-width: 0;
      }
      .top-title h1 {
        font-size: 0.9375rem;
        font-weight: 600;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 50vw;
      }
      .top-title .meta {
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
      }
      .top-actions {
        display: flex;
        gap: 0.5rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.9rem;
        border-radius: 6px;
        font-size: 0.8125rem;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        border: 1px solid var(--border);
        background: var(--panel-2);
        color: var(--text);
        font-family: inherit;
        transition: all 0.15s ease;
      }
      .btn:hover { border-color: #555; }
      .btn--primary {
        background: var(--accent-bg);
        color: var(--accent-fg);
        border-color: var(--accent-bg);
      }
      .btn--primary:hover { transform: translateY(-1px); }
      .btn--danger {
        color: #fca5a5;
        border-color: rgba(220, 38, 38, 0.32);
      }
      .btn--danger:hover { background: rgba(220, 38, 38, 0.12); }
      .btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
      }
      .canvas-area {
        grid-area: canvas;
        background: #050505;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        min-width: 0;
      }
      .canvas-wrap {
        position: relative;
        max-width: 100%;
        max-height: 100%;
        line-height: 0;
      }
      canvas#preview {
        max-width: 100%;
        max-height: calc(100vh - 56px);
        object-fit: contain;
        cursor: crosshair;
        display: block;
      }
      .vignette-overlay {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(ellipse at center,
          rgba(0,0,0,0) 30%,
          rgba(0,0,0,0.85) 100%);
        transition: opacity 0.1s ease;
      }
      .canvas-hint {
        position: absolute;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        color: var(--muted);
        font-size: 0.75rem;
        background: rgba(0, 0, 0, 0.6);
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        pointer-events: none;
      }
      .panel {
        grid-area: panel;
        background: var(--panel);
        border-left: 1px solid var(--border);
        overflow-y: auto;
        display: flex;
        flex-direction: column;
      }
      .panel-section {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border);
      }
      .panel-section h3 {
        margin: 0 0 0.875rem;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .panel-section h3 button {
        font-size: 0.6875rem;
        color: var(--muted);
        background: transparent;
        border: none;
        cursor: pointer;
        text-transform: none;
        letter-spacing: 0;
        padding: 0;
        font-weight: 400;
      }
      .panel-section h3 button:hover { color: var(--text); }
      .slider {
        display: grid;
        grid-template-columns: 1fr 56px;
        align-items: center;
        gap: 0.5rem 0.75rem;
        margin-bottom: 0.5rem;
      }
      .slider label {
        font-size: 0.8125rem;
        color: #d4d4d4;
      }
      .slider input[type="range"] {
        grid-column: 1 / 2;
        width: 100%;
        accent-color: #fafafa;
      }
      .slider .val {
        grid-column: 2 / 3;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
        color: var(--muted);
        text-align: right;
      }
      .crop-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .crop-buttons .btn {
        flex: 1 1 auto;
        justify-content: center;
        padding: 0.4rem 0.6rem;
        font-size: 0.75rem;
      }
      .crop-buttons .btn.active {
        background: var(--accent-bg);
        color: var(--accent-fg);
        border-color: var(--accent-bg);
      }
      .btn--ghost {
        background: transparent;
        color: var(--accent-fg);
        border-color: var(--border);
      }
      .btn--ghost:hover { background: var(--bg-hover); border-color: var(--accent); }
      .btn--ghost.active {
        background: var(--accent-bg);
        color: var(--accent-fg);
        border-color: var(--accent-bg);
      }
      .btn-compare-pill {
        padding: 0.5rem 1rem;
        font-weight: 600;
        background: var(--bg);
        border-color: var(--accent);
        color: var(--accent-fg);
      }
      .btn-compare-pill.active { background: var(--accent-bg); color: white; }
      .compare-icon {
        display: block;
        flex-shrink: 0;
      }
      .kbd-key {
        display: inline-block;
        padding: 0.1rem 0.5rem;
        margin-right: 0.4rem;
        background: var(--accent-bg);
        color: white;
        border-radius: 4px;
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
      }
      .compare-indicator {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(0, 0, 0, 0.7);
        color: #fafafa;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.875rem;
        letter-spacing: 0.1em;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.12s ease;
        z-index: 1000;
      }
      .compare-indicator.visible { opacity: 1; }
      .status {
        padding: 0.5rem 1.25rem;
        font-size: 0.75rem;
        background: var(--panel-2);
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .status.error { color: #fca5a5; }
      .status.ok { color: #86efac; }
      .toast {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.85);
        color: var(--text);
        padding: 0.75rem 1.25rem;
        border-radius: 999px;
        font-size: 0.8125rem;
        z-index: 100;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s ease;
      }
      .toast.visible { opacity: 1; }
      a.back-link {
        color: var(--muted);
        text-decoration: none;
        margin-right: 0.5rem;
        font-size: 0.8125rem;
      }
      a.back-link:hover { color: var(--text); }

      /* ============================================================
         MOBILE (≤768px) — stack vertically; let the page scroll;
         give the canvas real room instead of squeezing it.
         ============================================================ */
      @media (max-width: 768px) {
        html, body {
          overflow: auto;          /* allow scroll on mobile */
          height: auto;            /* drop the 100vh trap */
        }
        .editor {
          grid-template-columns: 1fr;
          grid-template-rows: auto auto 1fr;
          grid-template-areas:
            "top"
            "panel"
            "canvas";
          height: auto;            /* page grows to fit content */
        }
        .top {
          flex-wrap: wrap;
          padding: 0.5rem 0.75rem;
          gap: 0.5rem;
        }
        .top-title h1 {
          max-width: 60vw;
          font-size: 0.8125rem;
        }
        .top-title .meta {
          display: none;           /* 2066×3672 etc. takes too much room */
        }
        .top-actions {
          width: 100%;
          justify-content: flex-end;
        }
        .top-actions .btn {
          padding: 0.4rem 0.6rem;
          font-size: 0.75rem;
        }
        /* Reorder: top → canvas → panel. Above rule stacks them
           top/panel/canvas. Use order to put canvas first after top. */
        .top { order: 1; }
        .canvas-area { order: 2; }
        .panel { order: 3; }
        .canvas-area {
          min-height: 60vh;        /* canvas gets real estate */
          border-bottom: 1px solid var(--border);
        }
        canvas#preview {
          max-height: 60vh;        /* override the calc(100vh-56px) for mobile */
          max-width: 100%;
          width: auto;
          height: auto;
        }
        .panel {
          border-left: none;
          border-top: 1px solid var(--border);
          max-height: none;
        }
        .panel-section {
          padding: 0.75rem 1rem;
        }
      }

      @media (max-width: 420px) {
        .top-actions .btn-label { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="editor">
      <header class="top">
        <div class="top-title">
          <a class="back-link" href={`/admin/galleries/${img.gallery_id}`}>← Back</a>
          <h1>{img.original_name}</h1>
          <span class="meta">{img.width}×{img.height} · {img.mime}</span>
        </div>
        <div class="top-actions">
          <button class="btn" id="btn-reset">Reset</button>
          <button class="btn btn--ghost btn-compare-pill" id="btn-compare" type="button" aria-label="Hold to compare original" title="Hold to compare original (or press SPACE)" aria-pressed="false">
            <svg class="compare-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <rect x="2" y="4" width="9" height="16" rx="1" fill="currentColor" opacity="0.55"/>
              <rect x="13" y="4" width="9" height="16" rx="1" fill="currentColor"/>
              <line x1="12" y1="2" x2="12" y2="22" stroke="currentColor" stroke-width="1.25" opacity="0.85"/>
            </svg>
          </button>
          <button class="btn btn--danger" id="btn-revert" disabled={!latestEdit}>Revert to original</button>
          <button class="btn btn--primary" id="btn-save">Save edit</button>
        </div>
      </header>

      <div class="canvas-area">
        <div class="canvas-wrap">
          <canvas id="preview"></canvas>
          <div id="vignette-overlay" class="vignette-overlay"></div>
          <div id="crop-overlay"></div>
          <div class="canvas-hint">Drag on the image to set a crop · Sliders adjust live · Save to bake it in</div>
        </div>
      </div>

      <aside class="panel">
        <section class="panel-section">
          <h3>Light</h3>
          <div class="slider" data-key="exposure">
            <label>Exposure</label>
            <input type="range" min="-200" max="200" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="contrast">
            <label>Contrast</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="brightness">
            <label>Brightness</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <section class="panel-section">
          <h3>Tone <button id="btn-reset-tone">reset</button></h3>
          <div class="slider" data-key="highlights">
            <label>Highlights</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="shadows">
            <label>Shadows</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="whites">
            <label>Whites</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="blacks">
            <label>Blacks</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <section class="panel-section">
          <h3>Color <button id="btn-reset-color">reset</button></h3>
          <div class="slider" data-key="saturation">
            <label>Saturation</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="temp">
            <label>Temperature</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="tint">
            <label>Tint</label>
            <input type="range" min="-100" max="100" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <section class="panel-section">
          <h3>Effects <button id="btn-reset-fx">reset</button></h3>
          <div class="slider" data-key="sharpen">
            <label>Sharpen</label>
            <input type="range" min="0" max="100" step="1" />
            <span class="val">0</span>
          </div>
          <div class="slider" data-key="vignette">
            <label>Vignette</label>
            <input type="range" min="0" max="100" step="1" />
            <span class="val">0</span>
          </div>
        </section>

        <section class="panel-section">
          <h3>Crop</h3>
          <div class="crop-buttons">
            <button class="btn" data-aspect="free">Free</button>
            <button class="btn" data-aspect="1:1">1:1</button>
            <button class="btn" data-aspect="4:3">4:3</button>
            <button class="btn" data-aspect="3:2">3:2</button>
            <button class="btn" data-aspect="16:9">16:9</button>
            <button class="btn" id="btn-clear-crop">Clear</button>
          </div>
        </section>

        <div class="status" id="status">Ready.</div>
      </aside>
    </div>

    <div class="toast" id="toast"></div>
    <div id="compare-indicator" class="compare-indicator">ORIGINAL</div>

    <script type="module" define:vars={{
      imageId: img.id,
      sourceUrl,
      initialParams,
      hasExistingEdit: !!latestEdit,
    }}>

      // ---- Canvas 2D editor ----
      // Phase A: live preview via CSS filter on a Canvas 2D context.
      // Phase B-ready: Save sends params + crop to server which renders
      // at full resolution with sharp and writes the JPG to /uploads/edits/{id}/.
      // The original file is NEVER touched.
      const statusEl = document.getElementById('status');
      const btnSave = document.getElementById('btn-save');
      const btnRevert = document.getElementById('btn-revert');
      const btnReset = document.getElementById('btn-reset');

      const canvas = document.getElementById('preview');
      const ctx = canvas.getContext('2d');
      if (!ctx) {
        statusEl.textContent = 'Canvas 2D not supported in this browser.';
        statusEl.classList.add('error');
        throw new Error('no 2d ctx');
      }

      const state = { ...initialParams };
      const sourceImage = new Image();
      sourceImage.crossOrigin = 'anonymous';

      function setStatus(msg, isErr) {
        statusEl.textContent = msg;
        statusEl.classList.toggle('error', !!isErr);
        statusEl.classList.toggle('ok', !isErr);
      }

      function computeFilters() {
        const s = state;
        const f = [];
        // Exposure (-200..200) — divide by 100 = stops
        const exposureStops = s.exposure / 100;
        const expBrightness = Math.pow(2, exposureStops);  // 0.25..4
        f.push('brightness(' + expBrightness.toFixed(3) + ')');
        // Contrast (-100..100) — 0 = neutral, +/- = contrast change
        f.push('contrast(' + (100 + s.contrast) + '%)');
        // Saturation (-100..100)
        f.push('saturate(' + (100 + s.saturation) + '%)');
        // Brightness (-100..100) additive on top of exposure
        f.push('brightness(' + (100 + s.brightness) + '%)');
        // WB Temp (-100..100): warmer (positive) = sepia-ish; cooler = hue-rotate -ve
        if (s.temp > 0) f.push('sepia(' + Math.min(100, s.temp * 40) + '%)');
        else if (s.temp < 0) f.push('hue-rotate(' + Math.max(-180, s.temp * 30) + 'deg)');
        // Tint (-100..100): green vs magenta
        if (s.tint > 0) f.push('hue-rotate(' + Math.min(90, s.tint * 30) + 'deg)');
        // Shadows/Highlights/Whites/Blacks: stacked contrast tweak (rough)
        const shadowBoost = s.shadows / 100;       // negative darkens, positive lifts
        const highlightCut = s.highlights / 100;   // negative darkens, positive lifts
        if (s.shadows !== 0 || s.highlights !== 0) {
          // Approximate via a contrast/brightness combo
          const tones = (highlightCut - shadowBoost) * 0.2;
          f.push('contrast(' + (100 + tones * 20) + '%)');
          f.push('brightness(' + (100 + (shadowBoost + highlightCut) * 8) + '%)');
        }
        if (s.whites !== 0 || s.blacks !== 0) {
          // Endpoints — push contrast + slight brightness
          const ends = (s.whites - s.blacks) / 100;
          f.push('contrast(' + (100 + ends * 12) + '%)');
        }
        // Sharpen is now handled OUTSIDE the CSS filter chain via Canvas 2D
        // unsharp-mask in getSharpenedSource(). See below.
        return f.join(' ');
      }

      // ---- Unsharp mask via Canvas 2D ----
      // The previous SVG feConvolveMatrix approach broke (the rendered result
      // was going pure black). This is the textbook unsharp-mask recipe:
      //   1. Render source to off-screen canvas
      //   2. Apply Gaussian blur to a copy -> blurredData
      //   3. For each pixel: out = clamp( src + (src - blurred) * amount )
      // amount is 0..1 derived from slider 0..100. At amount=0 we just
      // return sourceImage (no extra work). Result: brightening of edges,
      // never pure-black. Cached so we only re-blur when amount changes.
      const _sharpenCanvas = document.createElement('canvas');
      const _sharpenCtx = _sharpenCanvas.getContext('2d');
      let _sharpenCacheKey = -1;
      let _sharpenCacheCanvas = null;

      function getSharpenedSource(amount) {
        if (!sourceImage.complete || !sourceImage.naturalWidth) return sourceImage;
        if (amount <= 0) return sourceImage;
        if (amount === _sharpenCacheKey && _sharpenCacheCanvas) return _sharpenCacheCanvas;

        const w = canvas.width;
        const h = canvas.height;
        _sharpenCanvas.width = w;
        _sharpenCanvas.height = h;

        // 1. Draw sharp source
        _sharpenCtx.clearRect(0, 0, w, h);
        _sharpenCtx.drawImage(sourceImage, 0, 0, w, h);
        const sharpImg = _sharpenCtx.getImageData(0, 0, w, h);

        // 2. Draw blurred source (CSS filter blur on canvas2d context)
        _sharpenCtx.filter = 'blur(1.2px)';
        _sharpenCtx.drawImage(sourceImage, 0, 0, w, h);
        _sharpenCtx.filter = 'none';
        const blurImg = _sharpenCtx.getImageData(0, 0, w, h);

        // 3. Unsharp mask: out = src + (src - blur) * amount
        const k = amount / 100;  // 0..1
        const sd = sharpImg.data;
        const bd = blurImg.data;
        for (let i = 0; i < sd.length; i += 4) {
          const dr = sd[i]   - bd[i];
          const dg = sd[i+1] - bd[i+1];
          const db = sd[i+2] - bd[i+2];
          let r = sd[i]   + dr * k;
          let g = sd[i+1] + dg * k;
          let b = sd[i+2] + db * k;
          if (r < 0) r = 0; else if (r > 255) r = 255;
          if (g < 0) g = 0; else if (g > 255) g = 255;
          if (b < 0) b = 0; else if (b > 255) b = 255;
          sd[i] = r; sd[i+1] = g; sd[i+2] = b;
        }
        _sharpenCtx.putImageData(sharpImg, 0, 0);
        _sharpenCacheKey = amount;
        _sharpenCacheCanvas = _sharpenCanvas;
        return _sharpenCanvas;
      }

      // Invalidate sharpen cache when source image changes
      const _origSourceAssign = sourceImage.src;
      sourceImage.addEventListener('load', () => {
        _sharpenCacheKey = -1;
        _sharpenCacheCanvas = null;
      });

      // Apply vignette overlay opacity (separate from canvas filter — vignette is a DOM overlay)
      const vignetteEl = document.getElementById('vignette-overlay');
      function applyVignetteOverlay() {
        const v = Number(state.vignette) || 0;
        if (v <= 0) { vignetteEl.style.opacity = '0'; return; }
        // 0..100 → 0..0.85 opacity
        const o = Math.max(0.05, Math.min(0.85, v / 100 * 0.85));
        vignetteEl.style.opacity = String(o);
      }
      window.applyVignetteOverlay = applyVignetteOverlay;

      // Sharpen is now handled via getSharpenedSource() below — unsharp-mask
      // in plain Canvas 2D pixel ops, no SVG filter dependency.

      function fitCanvasToArea() {
        const area = document.querySelector('.canvas-area');
        const aw = area ? area.clientWidth : window.innerWidth;
        const ah = area ? area.clientHeight : window.innerHeight;
        if (!sourceImage.width) return;
        const scale = Math.min(aw / sourceImage.width, ah / sourceImage.height, 1);
        const dw = Math.max(1, Math.round(sourceImage.width * scale));
        const dh = Math.max(1, Math.round(sourceImage.height * scale));
        canvas.width = dw;
        canvas.height = dh;
        canvas.style.width = dw + 'px';
        canvas.style.height = dh + 'px';
      }

      function draw() {
        if (!sourceImage.complete || !sourceImage.naturalWidth) return;
        ctx.save();
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        // Compare mode: show original, no crop mask, no filter
        if (comparing) {
          ctx.drawImage(sourceImage, 0, 0, canvas.width, canvas.height);
          ctx.restore();
          return;
        }
        // Apply crop via clip if set
        if (state.crop) {
          const c = state.crop;
          const cx = c.x * canvas.width, cy = c.y * canvas.height;
          const cw = c.w * canvas.width, ch = c.h * canvas.height;
          // Dim outside-crop area
          ctx.fillStyle = 'rgba(0,0,0,0.55)';
          ctx.fillRect(0, 0, canvas.width, cy);                   // top
          ctx.fillRect(0, cy, cx, ch);                            // left
          ctx.fillRect(cx + cw, cy, canvas.width - cx - cw, ch); // right
          ctx.fillRect(0, cy + ch, canvas.width, canvas.height); // bottom
          // Draw image inside crop
          ctx.beginPath();
          ctx.rect(cx, cy, cw, ch);
          ctx.clip();
        }
        // Apply CSS filter then draw the sharpened source image scaled to canvas
        ctx.filter = computeFilters();
        const drawSource = (state.sharpen > 0) ? getSharpenedSource(state.sharpen) : sourceImage;
        ctx.drawImage(drawSource, 0, 0, canvas.width, canvas.height);
        ctx.filter = 'none';
        ctx.restore();
        // Crop border
        if (state.crop) {
          const c = state.crop;
          const cx = c.x * canvas.width, cy = c.y * canvas.height;
          const cw = c.w * canvas.width, ch = c.h * canvas.height;
          ctx.strokeStyle = '#fafafa';
          ctx.lineWidth = 1.5;
          ctx.strokeRect(cx, cy, cw, ch);
          // Resize handles (4 corners)
          const h = 12;
          ctx.fillStyle = '#fafafa';
          [[cx,cy],[cx+cw,cy],[cx,cy+ch],[cx+cw,cy+ch]].forEach(([x,y]) => {
            ctx.fillRect(x - h/2, y - h/2, h, h);
          });
        }
      }

      sourceImage.onload = () => {
        fitCanvasToArea();
        _sharpenCacheKey = -1; // invalidate any stale sharpen cache
        applyVignetteOverlay();
        draw();
        setStatus('Loaded ' + sourceImage.width + 'x' + sourceImage.height + '. Display ' + canvas.width + 'x' + canvas.height + '.');
      };
      sourceImage.onerror = () => setStatus('Image load failed.', true);
      sourceImage.src = sourceUrl;

      // ---- Sliders ----
      document.querySelectorAll('.slider').forEach((wrap) => {
        const key = wrap.dataset.key;
        const input = wrap.querySelector('input');
        const valEl = wrap.querySelector('.val');
        input.value = state[key];
        valEl.textContent = state[key];
        input.addEventListener('input', () => {
          const v = Number(input.value);
          state[key] = v;
          valEl.textContent = v;
          if (key === 'sharpen') {
            _sharpenCacheKey = -1; // force re-blur next draw
            if (v > 0) getSharpenedSource(v);
          }
          applyVignetteOverlay();
          draw();
          draw();
        });
      });

      function resetKeys(keys) {
        keys.forEach((k) => { state[k] = 0; });
        document.querySelectorAll('.slider').forEach((wrap) => {
          if (keys.includes(wrap.dataset.key)) {
            const input = wrap.querySelector('input');
            const valEl = wrap.querySelector('.val');
            input.value = 0;
            valEl.textContent = '0';
          }
        });
        draw();
      }

      btnReset.onclick = () => {
        ['exposure','contrast','brightness','highlights','shadows','whites','blacks','saturation','temp','tint','sharpen','vignette'].forEach((k) => { state[k] = 0; });
        document.querySelectorAll('.slider').forEach((wrap) => {
          const input = wrap.querySelector('input');
          const valEl = wrap.querySelector('.val');
          input.value = 0;
          valEl.textContent = '0';
        });
        state.crop = null;
        draw();
      };
      document.getElementById('btn-reset-tone').onclick = () => resetKeys(['highlights','shadows','whites','blacks']);
      document.getElementById('btn-reset-color').onclick = () => resetKeys(['saturation','temp','tint']);
      document.getElementById('btn-reset-fx').onclick = () => { resetKeys(['sharpen','vignette']); };

      // ---- Crop drag (works on the canvas) ----
      let cropBox = null;       // { x, y, w, h } in canvas pixels
      let dragMode = null;      // 'create' | 'move' | 'nw' | 'ne' | 'sw' | 'se' | null
      let dragOffset = null;
      function getPos(e) {
        const r = canvas.getBoundingClientRect();
        const cx = (e.touches ? e.touches[0].clientX : e.clientX) - r.left;
        const cy = (e.touches ? e.touches[0].clientY : e.clientY) - r.top;
        return { x: cx * (canvas.width / r.width), y: cy * (canvas.height / r.height) };
      }
      canvas.addEventListener('mousedown', onDown);
      canvas.addEventListener('touchstart', onDown, { passive: false });
      window.addEventListener('mousemove', onMove);
      window.addEventListener('touchmove', onMove, { passive: false });
      window.addEventListener('mouseup', onUp);
      window.addEventListener('touchend', onUp);
      function onDown(e) {
        const p = getPos(e);
        // Hit-test corners of existing cropBox
        if (cropBox) {
          const h = 14;
          const corners = {
            nw: [cropBox.x, cropBox.y],
            ne: [cropBox.x + cropBox.w, cropBox.y],
            sw: [cropBox.x, cropBox.y + cropBox.h],
            se: [cropBox.x + cropBox.w, cropBox.y + cropBox.h],
          };
          for (const [name, [x, y]] of Object.entries(corners)) {
            if (Math.abs(p.x - x) <= h && Math.abs(p.y - y) <= h) {
              dragMode = name;
              e.preventDefault();
              return;
            }
          }
          if (p.x >= cropBox.x && p.x <= cropBox.x + cropBox.w && p.y >= cropBox.y && p.y <= cropBox.y + cropBox.h) {
            dragMode = 'move';
            dragOffset = { dx: p.x - cropBox.x, dy: p.y - cropBox.y };
            e.preventDefault();
            return;
          }
        }
        // Start a new crop
        cropBox = { x: p.x, y: p.y, w: 1, h: 1 };
        dragMode = 'se';
        e.preventDefault();
      }
      function onMove(e) {
        if (!dragMode) return;
        e.preventDefault();
        const p = getPos(e);
        if (dragMode === 'create' || dragMode === 'se') {
          cropBox.w = Math.max(2, p.x - cropBox.x);
          cropBox.h = Math.max(2, p.y - cropBox.y);
        } else if (dragMode === 'nw') {
          cropBox.w += cropBox.x - p.x; cropBox.h += cropBox.y - p.y;
          cropBox.x = p.x; cropBox.y = p.y;
        } else if (dragMode === 'ne') {
          cropBox.w = Math.max(2, p.x - cropBox.x);
          cropBox.h += cropBox.y - p.y; cropBox.y = p.y;
        } else if (dragMode === 'sw') {
          cropBox.w += cropBox.x - p.x; cropBox.x = p.x;
          cropBox.h = Math.max(2, p.y - cropBox.y);
        } else if (dragMode === 'move' && dragOffset) {
          cropBox.x = p.x - dragOffset.dx;
          cropBox.y = p.y - dragOffset.dy;
        }
        clampCrop();
        syncStateCrop();
        draw();
      }
      function onUp() {
        dragMode = null;
        dragOffset = null;
        if (cropBox && (cropBox.w < 8 || cropBox.h < 8)) {
          cropBox = null;
          state.crop = null;
          draw();
        }
      }
      function clampCrop() {
        if (!cropBox) return;
        cropBox.x = Math.max(0, Math.min(canvas.width - 2, cropBox.x));
        cropBox.y = Math.max(0, Math.min(canvas.height - 2, cropBox.y));
        cropBox.w = Math.max(2, Math.min(canvas.width - cropBox.x, cropBox.w));
        cropBox.h = Math.max(2, Math.min(canvas.height - cropBox.y, cropBox.h));
      }
      function syncStateCrop() {
        if (!cropBox) { state.crop = null; return; }
        state.crop = {
          x: cropBox.x / canvas.width,
          y: cropBox.y / canvas.height,
          w: cropBox.w / canvas.width,
          h: cropBox.h / canvas.height,
        };
      }

      // Aspect ratio presets
      let currentAspect = null;
      function setAspectPreset(ratio) {
        // ratio = w/h; null = free
        document.querySelectorAll('[data-aspect]').forEach((b) => b.classList.remove('active'));
        const label = ratio === null ? 'free' : (function () {
          // pick the closest standard button label to highlight
          const map = { '1': '1:1', '4/3': '4:3', '3/2': '3:2', '16/9': '16:9' };
          let best = null, bestDiff = Infinity;
          for (const [r, lbl] of Object.entries(map)) {
            const diff = Math.abs(Number(r) - ratio);
            if (diff < bestDiff) { bestDiff = diff; best = lbl; }
          }
          return bestDiff < 0.02 ? best : null;
        })();
        if (label) {
          const btn = document.querySelector('[data-aspect="' + label + '"]');
          if (btn) btn.classList.add('active');
        }
        currentAspect = ratio;
      }
      function makeCropAtAspect() {
        // Centre a crop as large as possible at the current aspect ratio
        const imgR = canvas.width / canvas.height;
        const wByH = currentAspect || imgR;
        let w, h;
        if (imgR > wByH) {
          w = Math.round(canvas.height * wByH);
          h = canvas.height;
        } else {
          w = canvas.width;
          h = Math.round(canvas.width / wByH);
        }
        cropBox = {
          x: Math.round((canvas.width - w) / 2),
          y: Math.round((canvas.height - h) / 2),
          w: w, h: h,
        };
        syncStateCrop();
      }
      document.querySelectorAll('[data-aspect]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const asp = btn.dataset.aspect;
          if (asp === 'free') { setAspectPreset(null); return; }
          const [aw, ah] = asp.split(':').map(Number);
          if (!aw || !ah) return;
          setAspectPreset(aw / ah);
          // ALWAYS reset to a fresh centred crop at this aspect fitted to the
          // FULL image bounds. Earlier behaviour preserved the old crop's
          // size when changing presets, so 4:3 → 16:9 cropped INSIDE the 4:3
          // area instead of replacing it. Now presets replace the crop
          // outright; dragging is still free-form and keeps current crop.
          makeCropAtAspect();
          clampCrop(); syncStateCrop(); draw();
        });
      });
      document.getElementById('btn-clear-crop').onclick = () => {
        cropBox = null; currentAspect = null;
        document.querySelectorAll('[data-aspect]').forEach((b) => b.classList.remove('active'));
        state.crop = null;
        draw();
      };

      // ---- Compare: hold button (or SPACE) to see the ORIGINAL ----
      // "Lightroom before/after" pattern. Drag = interactive, click = static.
      const btnCompare = document.getElementById('btn-compare');
      const indicatorEl = document.getElementById('compare-indicator');
      let comparing = false;
      function setComparing(v) {
        if (comparing === v) return;
        comparing = v;
        indicatorEl.classList.toggle('visible', v);
        btnCompare.classList.toggle('active', v);
        draw();
      }
      // mouse / touch — press to compare, release to return
      btnCompare.addEventListener('mousedown', () => setComparing(true));
      btnCompare.addEventListener('touchstart', (e) => { setComparing(true); e.preventDefault(); }, { passive: false });
      const releaseCompare = () => setComparing(false);
      window.addEventListener('mouseup', releaseCompare);
      window.addEventListener('touchend', releaseCompare);
      // Also SPACE while focused (keyboard shortcut)
      btnCompare.addEventListener('keydown', (e) => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); setComparing(true); } });
      btnCompare.addEventListener('keyup', (e) => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); setComparing(false); } });

      // Toast
      const toastEl = document.getElementById('toast');
      let toastT = null;
      function toast(msg) {
        toastEl.textContent = msg;
        toastEl.classList.add('visible');
        clearTimeout(toastT);
        toastT = setTimeout(() => toastEl.classList.remove('visible'), 2000);
      }

      // ---- Save → server-side render via sharp ----
      btnSave.onclick = async () => {
        btnSave.disabled = true;
        setStatus('Saving…');
        try {
          const res = await fetch('/api/images/' + imageId + '/edit', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ params: state, sourceUrl }),
          });
          if (!res.ok) throw new Error(await res.text());
          const data = await res.json();
          setStatus('Saved #' + data.edit.id + ' at ' + new Date(data.edit.created_at + 'Z').toLocaleTimeString() + '.');
          btnRevert.disabled = false;
          toast('Edit saved.');
        } catch (e) {
          console.error(e);
          setStatus('Save failed: ' + e.message, true);
        } finally {
          btnSave.disabled = false;
        }
      };

      btnRevert.onclick = async () => {
        if (!confirm('Discard all saved edits and revert to the original?')) return;
        btnRevert.disabled = true;
        try {
          const res = await fetch('/api/images/' + imageId + '/edit', { method: 'DELETE' });
          if (!res.ok) throw new Error(await res.text());
          setStatus('Reverted to original.');
          toast('Reverted.');
        } catch (e) {
          setStatus('Revert failed: ' + e.message, true);
          btnRevert.disabled = false;
        }
      };

      // Resize handling
      window.addEventListener('resize', () => {
        if (sourceImage.complete && sourceImage.naturalWidth) {
          fitCanvasToArea();
          draw();
        }
      });

      setStatus('Editor ready.');
</script>
  </body>
</html>
