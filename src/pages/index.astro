---
// SnappyDo landing — placeholder for v0.1
// Real content + gallery + builder comes in Wave 1 / 2
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SnappyDo — Photography websites that breathe</title>
    <meta name="description" content="A website builder for photographers. Framer-grade design meets SmugMug-grade workflow. Client galleries, proofing, print sales, image optimization — built in." />
  </head>
  <body>
    <main class="hero">
      <h1>SnappyDo</h1>
      <p class="tagline">Photography websites that breathe. Plus the business tools you'd actually use.</p>
      <p class="status">v0.1 — container alive, image pipeline next</p>
    </main>
    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: #0a0a0a;
        color: #fafafa;
        min-height: 100vh;
        display: grid;
        place-items: center;
      }
      .hero { text-align: center; padding: 4rem 2rem; max-width: 720px; }
      h1 {
        font-size: clamp(3rem, 8vw, 6rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        margin: 0 0 1rem;
        background: linear-gradient(135deg, #fafafa 0%, #888 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .tagline { font-size: 1.25rem; color: #b4b4b4; margin: 0 0 2rem; line-height: 1.5; }
      .status {
        display: inline-block;
        padding: 0.5rem 1rem;
        border: 1px solid #2a2a2a;
        border-radius: 999px;
        font-size: 0.875rem;
        color: #888;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
    </style>
  </body>
</html>
