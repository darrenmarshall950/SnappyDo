---
// SnappyDo landing — v0.3 gallery template + real uploads
import { listGalleries, imageCount } from '../lib/db';

const galleries = listGalleries();
const galleriesWithCounts = galleries.map((g) => ({
  ...g,
  count: imageCount(g.id),
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SnappyDo — Photography websites that breathe</title>
    <meta name="description" content="A website builder for photographers. Framer-grade design meets SmugMug-grade workflow. Client galleries, proofing, print sales, image optimization — built in." />
  </head>
  <body>
    <main class="hero">
      <p class="kicker">v0.3 — Real uploads · imgproxy · EXIF</p>
      <h1>SnappyDo</h1>
      <p class="tagline">Photography websites that breathe. Plus the business tools you'd actually use.</p>
      <p class="subtag">Drag-drop uploads · on-demand AVIF/WebP transforms · real EXIF extraction.</p>

      <div class="hero__cta">
        <a href="/upload" class="cta cta--primary">↑ Upload photos</a>
        <a href="/g/iceland-winter?t=masonry" class="cta cta--ghost">View sample gallery</a>
      </div>

      <section class="galleries">
        <h2>Galleries</h2>
        {galleriesWithCounts.length === 0 ? (
          <p class="empty">No galleries yet.</p>
        ) : (
          <ul>
            {galleriesWithCounts.map((g) => (
              <li>
                <a href={`/g/${g.slug}?t=${g.template_id}`} class="gallery-card">
                  <div class="gallery-card__meta">
                    <span class="gallery-card__title">{g.title}</span>
                    <span class="gallery-card__count">{g.count} {g.count === 1 ? 'photo' : 'photos'} · {g.template_id}</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    </main>
    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: #050505;
        color: #fafafa;
        min-height: 100vh;
      }
      .hero {
        padding: 5rem 2rem 6rem;
        max-width: 1100px;
        margin: 0 auto;
      }
      .kicker {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin: 0 0 1rem;
      }
      h1 {
        font-size: clamp(3.5rem, 10vw, 7rem);
        font-weight: 800;
        letter-spacing: -0.045em;
        margin: 0 0 1.5rem;
        background: linear-gradient(135deg, #fafafa 0%, #6b6b6b 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        line-height: 0.95;
      }
      .tagline {
        font-size: 1.5rem;
        color: #d4d4d4;
        margin: 0 0 0.5rem;
        max-width: 720px;
        line-height: 1.4;
      }
      .subtag {
        font-size: 1rem;
        color: #888;
        margin: 0 0 2rem;
      }
      .hero__cta {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 5rem;
        flex-wrap: wrap;
      }
      .cta {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.5rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9375rem;
        transition: transform 0.2s ease, background 0.2s ease;
      }
      .cta--primary {
        background: #fafafa;
        color: #0a0a0a;
      }
      .cta--primary:hover { background: #e5e5e5; transform: translateY(-1px); }
      .cta--ghost {
        border: 1px solid #2a2a2a;
        color: #fafafa;
      }
      .cta--ghost:hover { background: rgba(255,255,255,0.06); border-color: #444; }
      .galleries h2 {
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #888;
        font-weight: 500;
        margin: 0 0 1.5rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .galleries ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1rem;
      }
      .empty { color: #888; font-size: 0.9375rem; }
      .gallery-card {
        display: block;
        background: #0a0a0a;
        border: 1px solid #1a1a1a;
        border-radius: 8px;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.2s ease, transform 0.3s ease;
        padding: 1.25rem;
      }
      .gallery-card:hover {
        border-color: #333;
        transform: translateY(-2px);
      }
      .gallery-card__meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }
      .gallery-card__title { font-weight: 600; font-size: 1rem; }
      .gallery-card__count {
        color: #888;
        font-size: 0.75rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        text-align: right;
      }
    </style>
  </body>
</html>
