---
/**
 * TemplatePicker — switches the layout template for a gallery.
 *
 * On click: navigates to ?t={id} AND fires a POST /api/galleries/:id/template
 * to persist the choice in the database. Saved choice becomes the new default
 * for the gallery (visible on next visit, even without ?t=).
 */
import type { GalleryTemplateId } from '../../lib/gallery-schemas';
import { templateMeta, VALID_TEMPLATES } from '../../lib/gallery-schemas';

interface Props {
  current: GalleryTemplateId;
  gallerySlug: string;
  galleryId: number; // for persistence
  frame?: string; // optional frame style to persist alongside
}

const { current, gallerySlug, galleryId, frame } = Astro.props;
const templates: GalleryTemplateId[] = VALID_TEMPLATES;
---

<div class="template-picker" data-gallery-picker={gallerySlug} data-gallery-id={galleryId} data-frame={frame ?? ''}>
  <span class="template-picker__label">Layout</span>
  {templates.map((id) => (
    <a
      href={`/g/${gallerySlug}?t=${id}${frame ? `&frame=${frame}` : ''}`}
      class:list={['template-picker__btn', { 'is-active': id === current }]}
      data-template={id}
      title={templateMeta[id].description}
    >
      {templateMeta[id].name}
    </a>
  ))}
</div>

<script>
  (() => {
    const pickers = document.querySelectorAll('[data-gallery-picker]');
    pickers.forEach((picker) => {
      const slug = (picker as HTMLElement).dataset.galleryPicker!;
      const galleryId = Number((picker as HTMLElement).dataset.galleryId);
      const frame = (picker as HTMLElement).dataset.frame || '';
      picker.querySelectorAll<HTMLAnchorElement>('.template-picker__btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const template = btn.dataset.template;
          if (!template || !galleryId) return;
          // Fire-and-forget save — don't block navigation
          fetch(`/api/galleries/${galleryId}/template`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ template, frame: frame || undefined }),
            keepalive: true,
          }).catch(() => { /* silent — nav still works */ });
        });
      });
    });
  })();
</script>

<style>
  .template-picker {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem;
    border: 1px solid #2a2a2a;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    flex-wrap: wrap;
  }
  .template-picker__label {
    font-size: 0.6875rem;
    color: #888;
    padding: 0 0.5rem 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .template-picker__btn {
    padding: 0.4375rem 0.875rem;
    border-radius: 999px;
    color: #b4b4b4;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .template-picker__btn:hover { color: #fafafa; background: rgba(255, 255, 255, 0.06); }
  .template-picker__btn.is-active { background: #fafafa; color: #0a0a0a; }
</style>
