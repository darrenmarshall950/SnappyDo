---
import type { GalleryTemplateId } from '../../lib/gallery-schemas';
import { templateMeta } from '../../lib/gallery-schemas';

interface Props {
  current: GalleryTemplateId;
  gallerySlug: string;
}

const { current, gallerySlug } = Astro.props;
const templates: GalleryTemplateId[] = ['grid', 'masonry', 'lightbox'];
---

<div class="template-picker" data-gallery-picker={gallerySlug}>
  <span class="template-picker__label">Layout</span>
  {templates.map((id) => (
    <a
      href={`/g/${gallerySlug}?t=${id}`}
      class:list={['template-picker__btn', { 'is-active': id === current }]}
      data-template={id}
    >
      {templateMeta[id].name}
    </a>
  ))}
</div>

<style>
  .template-picker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem;
    border: 1px solid #2a2a2a;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
  }
  .template-picker__label {
    font-size: 0.75rem;
    color: #888;
    padding: 0 0.75rem 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }
  .template-picker__btn {
    padding: 0.4375rem 0.875rem;
    border-radius: 999px;
    color: #b4b4b4;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .template-picker__btn:hover { color: #fafafa; background: rgba(255, 255, 255, 0.06); }
  .template-picker__btn.is-active { background: #fafafa; color: #0a0a0a; }
</style>
