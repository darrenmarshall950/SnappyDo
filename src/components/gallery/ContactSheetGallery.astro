---
/**
 * ContactSheetGallery — vintage 35mm negative contact sheet.
 *
 * Visual brief:
 *   - Real negative strips from a film processor: one frame WIDE per strip,
 *     frames stacked vertically, sprocket holes along BOTH vertical edges.
 *   - Multiple strips laid side-by-side across the page (3–5 columns of strips).
 *   - Warm off-white light box background (photographer's light table).
 *   - Each strip looks like a piece of 35mm film — black base, sprocket holes.
 *   - Sprocket holes calculated by a fixed PITCH so they're consistent across
 *     strips of different lengths (mimics real 35mm sprocket spacing).
 *   - Sprockets slightly OFFSET between left and right edges (real film has
 *     this — registration index for the film advance mechanism).
 *   - Frame numbers running down the side ("01A", "02A", "03A"…).
 *   - Hover: frame brightens; click → existing lightbox.
 *
 * Schema: `columns` controls number of strips across the page (3–5).
 */
import type { AdaptedImage } from '../../lib/image-adapter';
import type { TemplateConfig } from '../../lib/gallery-schemas';
import Lightbox from './Lightbox.astro';

interface Props {
  images: AdaptedImage[];
  config: TemplateConfig;
  gallerySlug: string;
  galleryTitle?: string;
}

const { images, config, gallerySlug, galleryTitle } = Astro.props;

const stripsAcross = Math.min(5, Math.max(3, config.columns >= 3 && config.columns <= 5 ? config.columns : 4));

const edgeText = (config.watermark?.text && config.watermark.text.length > 0)
  ? config.watermark.text
  : 'KODAK PORTRA 400';
const year = new Date().getFullYear();
const edgeRunText = `${edgeText} • 35MM • 36 EXP • ${year}`;

// Real 35mm film has approximately 4 sprocket perforations per cm of film
// length, regardless of frame content. We use a fixed pitch (FRAME_PITCH_PX) so
// strip sprockets stay consistent across galleries with different frame counts.
const SPROCKET_PITCH_PX = 56;
// Number of sprockets per edge — based on the number of frames + a couple extras
// to feel real (real film typically has 8 sprockets per frame position).
function sprocketCount(frames: number) {
  return Math.max(8, Math.min(28, frames * 2 + 2));
}

// Distribute images into strips round-robin
const strips: AdaptedImage[][] = Array.from({ length: stripsAcross }, () => []);
images.forEach((img, i) => {
  strips[i % stripsAcross].push(img);
});
---

<div
  class="cs"
  data-template="contact-sheet"
  data-gallery={gallerySlug}
  style={`--bg:${config.background};--fg:${config.textColor};--strips:${stripsAcross};--sprocket-pitch:${SPROCKET_PITCH_PX}px;`}
>
  <div class="cs__table" role="list">
    {strips.map((strip, stripIdx) => {
      const rollNumber = String(stripIdx + 1).padStart(2, '0');
      const leftSprockets = sprocketCount(strip.length);
      const rightSprockets = sprocketCount(strip.length);
      // Offset right edge by half a pitch — mirrors real film registration
      const rightOffsetPx = -Math.round(SPROCKET_PITCH_PX / 2);
      return (
        <article class="cs__strip" role="listitem" aria-label={`Strip ${rollNumber}`}>
          {/* Top cap */}
          <div class="cs__cap" aria-hidden="true"></div>

          {/* Film body with sprocket rows + stacked frames */}
          <div class="cs__film">
            {/* Vertical sprocket holes — left edge */}
            <span class="cs__sprocket-col cs__sprocket-col--left" aria-hidden="true">
              {Array.from({ length: leftSprockets }).map((_, i) => (
                <span class="cs__hole" style={`--i:${i};--offset:0px;`}></span>
              ))}
            </span>

            {/* Vertical edge text running DOWN the LEFT edge */}
            <span class="cs__edge-text" aria-hidden="true">{edgeRunText}</span>

            {/* Stacked frames — single column */}
            <div class="cs__frames">
              {strip.map((img, frameIdx) => {
                const absIdx = (frameIdx * stripsAcross) + stripIdx;
                const frameLabel = `${String(absIdx + 1).padStart(2, '0')}A`;
                return (
                  <figure class="cs__frame" data-lightbox-trigger data-image-id={img.id} aria-label={`Frame ${frameLabel}`}>
                    <span class="cs__frame-num" aria-hidden="true">{frameLabel}</span>
                    <img
                      src={img.thumb}
                      srcset={img.srcset}
                      sizes={`(max-width: 720px) 50vw, ${Math.round(100 / stripsAcross)}vw`}
                      alt={img.alt}
                      loading={absIdx < 4 ? 'eager' : 'lazy'}
                      decoding="async"
                      width={img.width}
                      height={img.height}
                    />
                  </figure>
                );
              })}
            </div>

            {/* Vertical sprocket holes — right edge (offset by half-pitch) */}
            <span class="cs__sprocket-col cs__sprocket-col--right" aria-hidden="true" style={`--side-offset:${rightOffsetPx}px;`}>
              {Array.from({ length: rightSprockets }).map((_, i) => (
                <span class="cs__hole" style={`--i:${i};--offset:${rightOffsetPx}px;`}></span>
              ))}
            </span>
          </div>

          {/* Bottom cap */}
          <div class="cs__cap" aria-hidden="true"></div>

          {/* Strip label below */}
          <p class="cs__strip-label" aria-hidden="true">— {String.fromCharCode(65 + stripIdx)} —</p>
        </article>
      );
    })}
  </div>

  {galleryTitle && (
    <p class="cs__caption">Contact sheet preview · {galleryTitle}</p>
  )}
</div>

<Lightbox images={images} config={config} gallerySlug={gallerySlug} />

<style>
  .cs {
    --lightbox-bg: #ece5d4;
    --film-base: #0e0e0e;
    --film-shadow: #1c1c1c;
    --hole-color: #f5efe0;
    --edge-text-color: rgba(245, 230, 200, 0.55);
    background:
      radial-gradient(circle at 50% 0%, #f8f2e2 0%, var(--lightbox-bg) 60%, #d8cfba 100%);
    color: var(--fg);
    padding: clamp(2rem, 5vw, 4rem) clamp(0.5rem, 2vw, 2rem);
    min-height: 60vh;
  }

  /* Strips side-by-side */
  .cs__table {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(var(--strips), minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
  }

  /* Each strip is its own column */
  .cs__strip {
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--film-shadow) 0%, var(--film-base) 4%, var(--film-base) 96%, var(--film-shadow) 100%);
    border-radius: 2px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 24px 60px -20px rgba(0, 0, 0, 0.45),
      0 6px 18px -8px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  /* Top + bottom rounded caps of the film strip */
  .cs__cap {
    height: 6px;
    background: linear-gradient(180deg, var(--film-shadow), var(--film-base));
  }

  /* The body: holds frames + sprockets + edge text */
  .cs__film {
    position: relative;
    padding: clamp(1rem, 1.8vw, 1.5rem) clamp(1.5rem, 2vw, 2rem);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.02) 0%, transparent 50%, rgba(0,0,0,0.4) 100%),
      var(--film-base);
  }

  /* Vertical sprocket columns along left and right edges
   * Real 35mm sprockets are rectangular (tall:wide ≈ 2:1) with sharp corners.
   * Spacing is consistent (a fixed pitch per strip) and the right edge is
   * offset by half a pitch from the left, mimicking real film registration. */
  .cs__sprocket-col {
    position: absolute;
    top: clamp(1rem, 1.8vw, 1.5rem);
    bottom: clamp(1rem, 1.8vw, 1.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2px 0;
    pointer-events: none;
    gap: var(--sprocket-pitch);
  }
  .cs__sprocket-col--left { left: 4px; }
  .cs__sprocket-col--right { right: 4px; }

  /* One sprocket perforation — sharp rectangular hole punched through the film.
   * Aspect ratio mimics real 35mm perforations (~2.5:1 wide:tall… wait,
   * perforations are wider than tall in real 35mm — actually they're ~2mm
   * wide × ~1mm tall, so wider than tall. We render 14×7px with sharp
   * corners and a faint inner edge for depth. */
  .cs__hole {
    width: 14px;
    height: 7px;
    background: var(--hole-color);
    border-radius: 1px;
    flex-shrink: 0;
    box-shadow:
      /* Outer dim halo (the film thins around the perforation) */
      0 0 0 1px rgba(0, 0, 0, 0.4),
      /* Inner dark edge (the perforation's bevel) */
      inset 0 1px 0 rgba(0, 0, 0, 0.5),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3),
      /* Subtle light reflection on top edge */
      inset 0 -2px 1px rgba(255, 255, 255, 0.15);
  }

  /* Vertical edge text — left side, between sprocket column and frames */
  .cs__edge-text {
    position: absolute;
    left: 22px;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: left center;
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.5625rem;
    letter-spacing: 0.32em;
    color: var(--edge-text-color);
    text-transform: uppercase;
    user-select: none;
    pointer-events: none;
  }

  /* Stacked frames — single column */
  .cs__frames {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 1vw, 10px);
  }

  /* Each frame: 3:2 landscape (classic 35mm) */
  .cs__frame {
    position: relative;
    margin: 0;
    background: #000;
    overflow: hidden;
    cursor: zoom-in;
    aspect-ratio: 3 / 2;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
      0 0 0 1px rgba(0, 0, 0, 0.6);
  }

  .cs__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.92) contrast(1.02);
    transition: filter 0.35s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cs__frame:hover img,
  .cs__frame:focus-visible img {
    filter: brightness(1.04) contrast(1.04);
    transform: scale(1.03);
  }

  .cs__frame-num {
    position: absolute;
    top: 4px;
    left: 4px;
    z-index: 1;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    color: rgba(245, 230, 200, 0.6);
    background: rgba(0, 0, 0, 0.4);
    padding: 1px 4px;
    border-radius: 1px;
    pointer-events: none;
  }

  .cs__strip-label {
    text-align: center;
    margin: 0;
    padding: 5px 0 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(20, 18, 14, 0.55);
    background: var(--lightbox-bg);
  }

  .cs__caption {
    text-align: center;
    margin-top: 2rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(20, 18, 14, 0.6);
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .cs__table { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 800px) {
    .cs__table { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cs__hole { width: 12px; height: 6px; }
  }
  @media (max-width: 540px) {
    .cs__table { grid-template-columns: 1fr; max-width: 360px; }
    .cs__strip { margin: 0 auto; max-width: 320px; }
  }
</style>
