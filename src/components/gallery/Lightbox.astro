---
import type { AdaptedImage } from '../../lib/image-adapter';
import type { TemplateConfig } from '../../lib/gallery-schemas';

interface Props {
  images: AdaptedImage[];
  config: TemplateConfig;
  gallerySlug: string;
}

const { images, config, gallerySlug } = Astro.props;
---

<div
  class="lightbox"
  id={`lightbox-${gallerySlug}`}
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  hidden
>
  <div class="lightbox__backdrop"></div>

  <button class="lightbox__close" type="button" aria-label="Close (Esc)">×</button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Previous (←)">‹</button>
  <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Next (→)">›</button>

  <figure class="lightbox__figure">
    <img class="lightbox__image" alt="" />
    {config.showExif && (
      <figcaption class="lightbox__exif">
        <span data-field="camera"></span>
        <span data-field="lens"></span>
        <span data-field="settings"></span>
        <span data-field="taken"></span>
      </figcaption>
    )}
  </figure>

  <div class="lightbox__counter"><span data-current>1</span> / <span data-total>{images.length}</span></div>
</div>

<style>
  .lightbox[hidden] { display: none !important; }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, 0.96);
  }
  .lightbox__backdrop {
    position: absolute;
    inset: 0;
  }
  .lightbox__figure {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: min(95vw, 1800px);
    max-height: 92vh;
    display: grid;
    gap: 0.75rem;
  }
  .lightbox__image {
    max-width: 100%;
    max-height: 88vh;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    border-radius: 2px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
  }
  .lightbox__exif {
    color: #b4b4b4;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    z-index: 2;
    background: rgba(255, 255, 255, 0.08);
    color: #fafafa;
    border: 1px solid rgba(255, 255, 255, 0.16);
    width: 48px;
    height: 48px;
    border-radius: 999px;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    display: grid;
    place-items: center;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: scale(1.05);
  }
  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox__nav--prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__nav--prev:hover { transform: translateY(-50%) scale(1.05); }
  .lightbox__nav--next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__nav--next:hover { transform: translateY(-50%) scale(1.05); }
  .lightbox__counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: #888;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875rem;
    z-index: 2;
  }
</style>

<script define:vars={{ images, gallerySlug, showExif: config.showExif }}>
  // Lightbox controller — vanilla, no framework.
  (() => {
    const lb = document.getElementById(`lightbox-${gallerySlug}`);
    if (!lb) return;

    const img = lb.querySelector('.lightbox__image');
    const closeBtn = lb.querySelector('.lightbox__close');
    const prevBtn = lb.querySelector('.lightbox__nav--prev');
    const nextBtn = lb.querySelector('.lightbox__nav--next');
    const currentEl = lb.querySelector('[data-current]');
    const backdrop = lb.querySelector('.lightbox__backdrop');

    let current = 0;
    let lastFocus = null;

    function open(index) {
      current = index;
      lastFocus = document.activeElement;
      render();
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      lb.hidden = true;
      document.body.style.overflow = '';
      if (lastFocus) lastFocus.focus();
    }

    function render() {
      const image = images[current];
      img.src = image.src;
      img.alt = image.alt;
      currentEl.textContent = current + 1;

      if (showExif) {
        const exif = lb.querySelector('.lightbox__exif');
        if (exif) {
          exif.querySelector('[data-field="camera"]').textContent = image.exif.camera;
          exif.querySelector('[data-field="lens"]').textContent = image.exif.lens;
          exif.querySelector('[data-field="settings"]').textContent =
            `${image.exif.focalLength} · ${image.exif.aperture} · 1/${image.exif.shutter.replace('1/', '')}s · ISO ${image.exif.iso}`;
          exif.querySelector('[data-field="taken"]').textContent = new Date(image.exif.takenAt).toLocaleDateString();
        }
      }
    }

    function next() { current = (current + 1) % images.length; render(); }
    function prev() { current = (current - 1 + images.length) % images.length; render(); }

    // Hook up triggers — any [data-image-index] inside this gallery's container
    document.querySelectorAll(`[data-gallery="${gallerySlug}"] [data-image-index]`).forEach((btn, i) => {
      btn.addEventListener('click', () => open(i));
    });

    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    nextBtn.addEventListener('click', next);
    prevBtn.addEventListener('click', prev);

    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    });
  })();
</script>
