---
/**
 * Lightbox — full-resolution image viewer.
 *
 * Loads the photographer's native-resolution image (no resize, JPEG @ 95%).
 * This is the most important UX of a photography site: when a viewer clicks
 * a thumbnail, they want to see the image at the resolution it was shot at.
 *
 * Features:
 *   - Native-resolution display (preserves photographer's craft)
 *   - EXIF metadata bar
 *   - Download original
 *   - Keyboard: Esc / ← / →
 *   - Preloads adjacent images for instant nav
 */
import type { AdaptedImage } from '../../lib/image-adapter';
import type { TemplateConfig } from '../../lib/gallery-schemas';

interface Props {
  images: AdaptedImage[];
  config: TemplateConfig;
  gallerySlug: string;
}

const { images, config, gallerySlug } = Astro.props;
---

<div
  class="lightbox"
  id={`lightbox-${gallerySlug}`}
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  hidden
>
  <div class="lightbox__backdrop"></div>

  <button class="lightbox__close" type="button" aria-label="Close (Esc)">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M6 18L18 6"/></svg>
  </button>
  <button class="lightbox__zoom" type="button" aria-label="Toggle zoom (click image)">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" data-zoom-icon-in><circle cx="11" cy="11" r="7"/><path d="M11 8v6M8 11h6M21 21l-4.35-4.35"/></svg>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" data-zoom-icon-out style="display:none;"><circle cx="11" cy="11" r="7"/><path d="M8 11h6M21 21l-4.35-4.35"/></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Previous (←)">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 6l-6 6 6 6"/></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Next (→)">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6l6 6-6 6"/></svg>
  </button>

  <figure class="lightbox__figure">
    <div class="lightbox__img-wrap" data-img-wrap>
      <div class="lightbox__loader" data-loader>
        <div class="lightbox__loader-spinner"></div>
        <p class="lightbox__loader-text">Loading full resolution…</p>
      </div>
      <img class="lightbox__image" alt="" decoding="async" data-lightbox-img />
    </div>
    <figcaption class="lightbox__exif" data-exif>
      <span class="lightbox__exif-camera" data-field="camera"></span>
      <span class="lightbox__exif-line" data-field="lens"></span>
      <span class="lightbox__exif-line" data-field="settings"></span>
      <span class="lightbox__exif-line" data-field="dims"></span>
      <a class="lightbox__download" data-field="download" download>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14"/></svg>
        Download original
      </a>
    </figcaption>
  </figure>

  <div class="lightbox__counter">
    <span data-current>1</span> / <span data-total>{images.length}</span>
  </div>
</div>

<style>
  .lightbox[hidden] { display: none !important; }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, 0.97);
    animation: lbFade 0.2s ease;
  }
  @keyframes lbFade { from { opacity: 0; } to { opacity: 1; } }
  .lightbox__backdrop { position: absolute; inset: 0; }
  .lightbox__figure {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 96vw;
    max-height: 96vh;
    display: grid;
    gap: 0.75rem;
  }
  .lightbox__img-wrap {
    position: relative;
    max-width: 96vw;
    max-height: 88vh;
    display: grid;
    place-items: center;
  }
  .lightbox__image {
    max-width: 96vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
    border-radius: 2px;
    opacity: 0;
    transition: opacity 0.4s ease;
    transform-origin: center center;
    will-change: transform;
  }
  .lightbox__image.is-loaded { opacity: 1; }
  .lightbox__image.is-zoomable { cursor: zoom-in; }
  .lightbox__image.is-zoomed { cursor: grab; }
  .lightbox__image.is-zoomed:active { cursor: grabbing; }
  .lightbox__image.is-panning { transition: none; }
  .lightbox__loader {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #888;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .lightbox__loader.is-hidden { opacity: 0; }
  .lightbox__loader-spinner {
    width: 28px;
    height: 28px;
    border: 2px solid rgba(255, 255, 255, 0.08);
    border-top-color: #fafafa;
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
    margin-bottom: 0.75rem;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .lightbox__loader-text { margin: 0; }
  .lightbox__exif {
    color: #d4d4d4;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
  }
  .lightbox__exif-camera {
    color: #fafafa;
    font-weight: 600;
  }
  .lightbox__exif-line {
    color: #888;
  }
  .lightbox__download {
    color: #fafafa;
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .lightbox__download:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.32);
  }
  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    z-index: 2;
    background: rgba(255, 255, 255, 0.06);
    color: #fafafa;
    border: 1px solid rgba(255, 255, 255, 0.12);
    width: 48px;
    height: 48px;
    border-radius: 999px;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s ease, transform 0.2s ease;
    backdrop-filter: blur(12px);
  }
  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  .lightbox__close { top: 1.25rem; right: 1.25rem; }
  .lightbox__zoom {
    top: 1.25rem;
    right: 4.5rem;
  }
  .lightbox__zoom.is-active {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.32);
  }
  .lightbox__nav--prev { left: 1.25rem; top: 50%; transform: translateY(-50%); }
  .lightbox__nav--prev:hover { transform: translateY(-50%) scale(1.05); }
  .lightbox__nav--next { right: 1.25rem; top: 50%; transform: translateY(-50%); }
  .lightbox__nav--next:hover { transform: translateY(-50%) scale(1.05); }
  .lightbox__counter {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    color: #888;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    z-index: 2;
    letter-spacing: 0.12em;
  }
  .lightbox__counter span { color: #fafafa; }
</style>

<script define:vars={{ images, gallerySlug, showExif: config.showExif }}>
  (() => {
    const lb = document.getElementById(`lightbox-${gallerySlug}`);
    if (!lb) return;

    const img = lb.querySelector('[data-lightbox-img]');
    const wrap = lb.querySelector('[data-img-wrap]');
    const loader = lb.querySelector('[data-loader]');
    const closeBtn = lb.querySelector('.lightbox__close');
    const zoomBtn = lb.querySelector('.lightbox__zoom');
    const prevBtn = lb.querySelector('.lightbox__nav--prev');
    const nextBtn = lb.querySelector('.lightbox__nav--next');
    const currentEl = lb.querySelector('[data-current]');
    const backdrop = lb.querySelector('.lightbox__backdrop');
    const downloadEl = lb.querySelector('[data-field="download"]');
    const zoomIconIn = lb.querySelector('[data-zoom-icon-in]');
    const zoomIconOut = lb.querySelector('[data-zoom-icon-out]');

    let current = 0;
    let lastFocus = null;
    const preloads = new Map();

    // ---- Photo zoom state ----
    let zoom = 1;             // current scale
    let panX = 0;             // px translate
    let panY = 0;
    let isPanning = false;
    let panStartX = 0;
    let panStartY = 0;
    let panOriginX = 0;
    let panOriginY = 0;
    const MIN_ZOOM = 1;
    const MAX_ZOOM = 8;

    function applyZoom(animate = true) {
      if (animate) img.style.transition = 'transform 0.25s cubic-bezier(0.16,1,0.3,1), opacity 0.4s ease';
      else img.style.transition = 'opacity 0.4s ease';
      img.style.transform = `translate(${panX}px, ${panY}px) scale(${zoom})`;
      img.classList.toggle('is-zoomed', zoom > 1.001);
      img.classList.toggle('is-zoomable', zoom <= 1.001);
      zoomBtn?.classList.toggle('is-active', zoom > 1.001);
      if (zoomIconIn && zoomIconOut) {
        zoomIconIn.style.display = zoom > 1.001 ? 'none' : '';
        zoomIconOut.style.display = zoom > 1.001 ? '' : 'none';
      }
    }

    function zoomTo(newZoom, cx, cy) {
      const prev = zoom;
      zoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, newZoom));
      if (zoom <= 1.001) {
        panX = 0; panY = 0;
      } else if (cx !== undefined && cy !== undefined) {
        // Zoom around (cx, cy) in image-relative coords
        const rect = img.getBoundingClientRect();
        const offsetX = cx - rect.left - rect.width / 2;
        const offsetY = cy - rect.top - rect.height / 2;
        const ratio = zoom / prev;
        panX = (panX - offsetX) * ratio + offsetX;
        panY = (panY - offsetY) * ratio + offsetY;
      }
      clampPan();
      applyZoom(true);
    }

    function clampPan() {
      if (zoom <= 1.001) return;
      const rect = img.getBoundingClientRect();
      // After zoom, image dimensions are scaled; pan limit so edges stay within view
      const scaledW = rect.width * zoom;
      const scaledH = rect.height * zoom;
      const limitX = Math.max(0, (scaledW - rect.width) / 2);
      const limitY = Math.max(0, (scaledH - rect.height) / 2);
      panX = Math.max(-limitX, Math.min(limitX, panX));
      panY = Math.max(-limitY, Math.min(limitY, panY));
    }

    function resetZoom() { zoom = 1; panX = 0; panY = 0; applyZoom(true); }

    // Click image: zoom 2x at click point; double-click: reset
    let clickTimer = null;
    img.addEventListener('click', (e) => {
      if (isPanning) return;
      if (clickTimer) {
        clearTimeout(clickTimer); clickTimer = null;
        resetZoom();
        return;
      }
      clickTimer = window.setTimeout(() => {
        clickTimer = null;
        if (zoom > 1.001) {
          resetZoom();
        } else {
          zoomTo(2.5, e.clientX, e.clientY);
        }
      }, 220);
    });

    img.addEventListener('mousedown', (e) => {
      if (zoom <= 1.001) return;
      e.preventDefault();
      isPanning = true;
      panStartX = e.clientX;
      panStartY = e.clientY;
      panOriginX = panX;
      panOriginY = panY;
      img.classList.add('is-panning');
    });
    window.addEventListener('mousemove', (e) => {
      if (!isPanning) return;
      panX = panOriginX + (e.clientX - panStartX);
      panY = panOriginY + (e.clientY - panStartY);
      clampPan();
      applyZoom(false);
    });
    window.addEventListener('mouseup', () => {
      if (!isPanning) return;
      isPanning = false;
      img.classList.remove('is-panning');
    });

    // Wheel zoom around cursor
    wrap.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = -e.deltaY * 0.005;
      zoomTo(zoom * (1 + delta), e.clientX, e.clientY);
    }, { passive: false });

    zoomBtn?.addEventListener('click', () => {
      if (zoom > 1.001) resetZoom();
      else zoomTo(2.5);
    });

    function preload(i) {
      if (preloads.has(i)) return preloads.get(i);
      const p = new Image();
      p.src = images[i].full;
      preloads.set(i, p);
      return p;
    }

    function open(index) {
      current = index;
      lastFocus = document.activeElement;
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
      render();
      closeBtn.focus();
      // Preload neighbours
      preload((current + 1) % images.length);
      preload((current - 1 + images.length) % images.length);
    }

    function close() {
      lb.hidden = true;
      document.body.style.overflow = '';
      if (lastFocus) lastFocus.focus();
    }

    function render() {
      const image = images[current];
      img.classList.remove('is-loaded');
      loader.classList.remove('is-hidden');

      // Show mid-size immediately while full-res loads
      img.src = image.src;
      img.alt = image.alt;
      currentEl.textContent = current + 1;
      resetZoom();

      // Then swap to full-res
      const fullImg = new Image();
      fullImg.onload = () => {
        // Only swap if we're still showing this image
        if (current === indexOf(image)) {
          img.src = image.full;
          img.classList.add('is-loaded');
          loader.classList.add('is-hidden');
        }
      };
      fullImg.onerror = () => {
        loader.classList.add('is-hidden');
        img.classList.add('is-loaded');
      };
      fullImg.src = image.full;
      preloads.set(current, fullImg);

      if (showExif) {
        const exif = image.exif;
        lb.querySelector('[data-field="camera"]').textContent = exif.camera;
        lb.querySelector('[data-field="lens"]').textContent = exif.lens;
        const settingsParts = [];
        if (exif.focalLength && exif.focalLength !== '—') settingsParts.push(exif.focalLength);
        if (exif.aperture && exif.aperture !== '—') settingsParts.push(exif.aperture);
        if (exif.shutter && exif.shutter !== '—') settingsParts.push(exif.shutter === '1/0s' ? '' : `${exif.shutter}s`);
        if (exif.iso) settingsParts.push(`ISO ${exif.iso}`);
        lb.querySelector('[data-field="settings"]').textContent = settingsParts.filter(Boolean).join(' · ');
        lb.querySelector('[data-field="dims"]').textContent = `${image.width} × ${image.height}`;
        if (downloadEl) downloadEl.href = image.full;
      }
    }

    function indexOf(image) {
      return images.findIndex((x) => x.id === image.id);
    }

    function next() { current = (current + 1) % images.length; render(); preload((current + 1) % images.length); }
    function prev() { current = (current - 1 + images.length) % images.length; render(); preload((current - 1 + images.length) % images.length); }

    document.querySelectorAll(`[data-gallery="${gallerySlug}"] [data-image-index]`).forEach((btn, i) => {
      btn.addEventListener('click', () => open(i));
    });

    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    nextBtn.addEventListener('click', next);
    prevBtn.addEventListener('click', prev);

    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    });
  })();
</script>
