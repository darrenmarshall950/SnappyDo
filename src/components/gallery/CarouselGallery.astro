---
/**
 * CarouselGallery — single-image showcase with prev/next + dots.
 *
 * Editorial pacing. One image at a time, large, with metadata panel.
 * Keyboard: ←/→ to navigate, Esc to close.
 */
import type { AdaptedImage } from '../../lib/image-adapter';

export interface Props {
  images: AdaptedImage[];
  config: import('../../lib/gallery-schemas').TemplateConfig;
  galleryTitle: string;
}

const { images, config, galleryTitle } = Astro.props;
---

<div class="carousel" data-template="carousel" style={`background:${config.background};color:${config.textColor};`}>
  <div class="carousel__viewport" data-carousel-viewport>
    {images.map((img, i) => (
      <article class="carousel__slide" data-carousel-slide data-index={i} aria-hidden={i !== 0 ? 'true' : 'false'}>
        <img
          src={img.src}
          srcset={img.srcset}
          sizes="100vw"
          alt={img.alt}
          class="carousel__img"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
        {img.exif && Object.keys(img.exif).length > 0 && (
          <aside class="carousel__meta">
            {img.exif.camera && <p class="carousel__meta-line"><strong>{img.exif.camera}</strong></p>}
            <p class="carousel__meta-line">
              {img.exif.lens && <span>{img.exif.lens}</span>}
              {img.exif.lens && img.exif.focalLength && <span> · </span>}
              {img.exif.focalLength && <span>{img.exif.focalLength}</span>}
            </p>
            <p class="carousel__meta-line">
              {img.exif.aperture && <span>ƒ/{img.exif.aperture}</span>}
              {img.exif.shutter && <span> · {img.exif.shutter}</span>}
              {img.exif.iso && <span> · ISO {img.exif.iso}</span>}
            </p>
          </aside>
        )}
      </article>
    ))}
  </div>

  <button class="carousel__nav carousel__nav--prev" data-carousel-prev aria-label="Previous image">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button class="carousel__nav carousel__nav--next" data-carousel-next aria-label="Next image">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg>
  </button>

  <div class="carousel__hud">
    <p class="carousel__hud-title">{galleryTitle}</p>
    <p class="carousel__hud-counter">
      <span data-carousel-current>1</span> / <span>{images.length}</span>
    </p>
    <ol class="carousel__dots" role="tablist">
      {images.map((_, i) => (
        <li>
          <button
            class="carousel__dot"
            data-carousel-dot
            data-index={i}
            aria-label={`Go to image ${i + 1}`}
            aria-current={i === 0 ? 'true' : 'false'}
          />
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  const root = document.currentScript?.previousElementSibling as HTMLElement | null;
  // Find the carousel in the DOM (script context)
  const carousel = document.querySelector('[data-carousel-viewport]')?.parentElement;
  if (carousel) {
    const viewport = carousel.querySelector('[data-carousel-viewport]') as HTMLElement;
    const slides = Array.from(carousel.querySelectorAll('[data-carousel-slide]')) as HTMLElement[];
    const prev = carousel.querySelector('[data-carousel-prev]') as HTMLButtonElement;
    const next = carousel.querySelector('[data-carousel-next]') as HTMLButtonElement;
    const dots = Array.from(carousel.querySelectorAll('[data-carousel-dot]')) as HTMLButtonElement[];
    const counter = carousel.querySelector('[data-carousel-current]') as HTMLElement;
    let current = 0;

    function go(i: number) {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => {
        s.style.transform = `translateX(${(idx - current) * 100}%)`;
        s.setAttribute('aria-hidden', idx === current ? 'false' : 'true');
      });
      dots.forEach((d, idx) => d.setAttribute('aria-current', idx === current ? 'true' : 'false'));
      counter.textContent = String(current + 1);
    }

    prev.addEventListener('click', () => go(current - 1));
    next.addEventListener('click', () => go(current + 1));
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.index))));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(current - 1);
      if (e.key === 'ArrowRight') go(current + 1);
    });
    go(0);
  }
</script>

<style>
  .carousel {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
  }
  .carousel__viewport {
    position: relative;
    width: 100%;
    height: 100vh;
    display: grid;
  }
  .carousel__slide {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 4rem 6rem;
  }
  .carousel__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.4));
  }
  .carousel__meta {
    position: absolute;
    bottom: 6rem;
    right: 3rem;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 0.875rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #e5e5e5;
    max-width: 320px;
  }
  .carousel__meta-line { margin: 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .carousel__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.12);
    color: inherit;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }
  .carousel__nav:hover { background: rgba(255,255,255,0.12); }
  .carousel__nav--prev { left: 1.5rem; }
  .carousel__nav--next { right: 1.5rem; }
  .carousel__hud {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 10;
  }
  .carousel__hud-title {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #d4d4d4;
    margin: 0;
  }
  .carousel__hud-counter {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    color: #888;
    margin: 0;
  }
  .carousel__dots {
    list-style: none;
    display: flex;
    gap: 0.375rem;
    padding: 0;
    margin: 0;
  }
  .carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.4);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .carousel__dot[aria-current="true"] {
    background: #fff;
    transform: scale(1.25);
  }
</style>
